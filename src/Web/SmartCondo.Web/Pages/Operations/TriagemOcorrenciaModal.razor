@using Microsoft.AspNetCore.Components.Web
@using Modules.Operations.Application.DTOs
@using Modules.Operations.Domain.Enums
@using SmartCondo.Web.Services
@inject AiApiClient AiClient

@if (IsOpen)
{
    <div class="modal-backdrop fade show" style="display: block; background: rgba(0,0,0,0.5); z-index: 1050;"></div>
    <div class="modal fade show" style="display: block; z-index: 1055;" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <!-- Header no padrão Stitch (Gradiente Roxo / IA) -->
                <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle p-2 bg-white bg-opacity-20 d-flex align-items-center justify-content-center">
                            <span class="material-symbols-outlined fs-2 text-white">auto_awesome</span>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Triagem Inteligente de Ocorrência por IA</h5>
                            <small class="text-white-50">Envie foto e/ou relato de áudio para classificação e direcionamento automático.</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>

                <div class="modal-body p-4 bg-light">
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger rounded-3 d-flex align-items-center gap-2 mb-3">
                            <span class="material-symbols-outlined fs-5">warning</span>
                            <span>@ErrorMessage</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(SuccessMessage))
                    {
                        <div class="alert alert-success rounded-3 d-flex align-items-center gap-2 mb-3">
                            <span class="material-symbols-outlined fs-5">check_circle</span>
                            <span>@SuccessMessage</span>
                        </div>
                    }

                    <!-- Presets Rápidos de Simulação -->
                    <div class="mb-4 p-3 bg-white rounded-3 shadow-sm border border-light">
                        <span class="text-muted small fw-semibold text-uppercase tracking-wider d-block mb-2">Simulações Rápidas (Foto / Áudio):</span>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-sm btn-outline-primary rounded-pill d-flex align-items-center gap-1" @onclick="PresetInfiltracao">
                                <span class="material-symbols-outlined fs-6">water_drop</span>
                                <span>Infiltração Garagem (Foto)</span>
                            </button>
                            <button class="btn btn-sm btn-outline-purple rounded-pill d-flex align-items-center gap-1" style="color:#7C3AED; border-color:#7C3AED;" @onclick="PresetSomAlto">
                                <span class="material-symbols-outlined fs-6">volume_up</span>
                                <span>Som Alto / Perturbação (Áudio)</span>
                            </button>
                            <button class="btn btn-sm btn-outline-success rounded-pill d-flex align-items-center gap-1" @onclick="PresetLampada">
                                <span class="material-symbols-outlined fs-6">lightbulb</span>
                                <span>Lâmpada Queimada (Foto)</span>
                            </button>
                        </div>
                    </div>

                    <!-- Formulário de Entrada -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">URL da Foto / Evidência Visual</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><span class="material-symbols-outlined fs-5 text-muted">image</span></span>
                                <input type="text" class="form-control border-start-0" @bind="FotoUrl" placeholder="https://..." />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">URL do Áudio / Transcrição de Voz</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><span class="material-symbols-outlined fs-5 text-muted">mic</span></span>
                                <input type="text" class="form-control border-start-0" @bind="AudioUrl" placeholder="https://... ou transcrição" />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold text-dark small">Relato Livre do Morador</label>
                            <textarea class="form-control" rows="2" @bind="RelatoTexto" placeholder="Descreva o problema ou forneça detalhes adicionais..."></textarea>
                        </div>
                    </div>

                    <!-- Botões de Ação IA -->
                    <div class="d-flex gap-2 mb-4">
                        <button class="btn btn-outline-primary rounded-3 px-4 fw-semibold d-flex align-items-center gap-2" @onclick="AnalisarSemSalvar" disabled="@IsProcessing">
                            @if (IsAnalyzing)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Analisando IA...</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined fs-5">search_check</span>
                                <span>Análise Prévia (Sem Salvar)</span>
                            }
                        </button>

                        <button class="btn btn-primary rounded-3 px-4 fw-semibold d-flex align-items-center gap-2 text-white" style="background: #4F46E5; border: none;" @onclick="TriarEAbrirChamado" disabled="@IsProcessing">
                            @if (IsOpening)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Triando e Criando Chamado...</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined fs-5">bolt</span>
                                <span>Triar & Abrir Chamado por IA</span>
                            }
                        </button>
                    </div>

                    <!-- Card Resultado Stitch -->
                    @if (ResultadoTriagem != null)
                    {
                        <div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden border-start border-4 border-indigo" style="border-left-color: #4F46E5 !important;">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="badge bg-indigo-subtle text-indigo fw-bold px-3 py-2 rounded-pill d-flex align-items-center gap-1" style="background:#EEF2FF; color:#4F46E5;">
                                        <span class="material-symbols-outlined fs-6">verified</span>
                                        <span>@((ResultadoTriagem.NivelConfianca * 100).ToString("F0"))% Confiança IA</span>
                                    </span>
                                    <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                                        Origem: @ResultadoTriagem.OrigemTriagem
                                    </span>
                                </div>

                                <h5 class="fw-bold text-dark mb-2">@ResultadoTriagem.TituloSugerido</h5>
                                <p class="text-muted small mb-3">@ResultadoTriagem.DescricaoDetalhada</p>

                                <div class="row g-2 mb-3">
                                    <div class="col-md-3">
                                        <div class="p-2 rounded bg-light border text-center">
                                            <span class="text-muted extra-small d-block fw-semibold">CATEGORIA</span>
                                            <span class="fw-bold text-dark">@ResultadoTriagem.CategoriaInferida</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="p-2 rounded bg-light border text-center">
                                            <span class="text-muted extra-small d-block fw-semibold">PRIORIDADE</span>
                                            <span class="fw-bold text-danger">@ResultadoTriagem.PrioridadeInferida</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-2 rounded bg-light border">
                                            <span class="text-muted extra-small d-block fw-semibold">LOCAL & SETOR DIRECIÓNADO</span>
                                            <span class="fw-bold text-dark truncate d-block">@ResultadoTriagem.LocalizacaoSugerida • @ResultadoTriagem.SetorResponsavelSugerido</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="p-3 bg-light-subtle rounded-3 border-start border-3 border-warning">
                                    <small class="fw-bold text-dark d-block mb-1">Justificativa do Agente IA:</small>
                                    <small class="text-muted">@ResultadoTriagem.JustificativaIa</small>
                                </div>

                                @if (ResultadoTriagem.OcorrenciaCriadaId.HasValue)
                                {
                                    <div class="mt-3 p-3 bg-success-subtle text-success rounded-3 d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="material-symbols-outlined fs-5">task_alt</span>
                                            <span class="fw-bold">Chamado #@ResultadoTriagem.OcorrenciaCriadaId.Value.ToString()[..8] registrado no sistema!</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-white border-top-0 p-3">
                    <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" @onclick="Close">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    public string? FotoUrl { get; set; }
    public string? AudioUrl { get; set; }
    public string? RelatoTexto { get; set; }

    public bool IsAnalyzing { get; set; }
    public bool IsOpening { get; set; }
    public bool IsProcessing => IsAnalyzing || IsOpening;

    public string? ErrorMessage { get; set; }
    public string? SuccessMessage { get; set; }

    public ResultadoTriagemOcorrenciaDto? ResultadoTriagem { get; set; }

    private void PresetInfiltracao()
    {
        FotoUrl = "https://storage.smartcondo.com/evidences/infiltracao-garagem-b2.jpg";
        AudioUrl = null;
        RelatoTexto = "Infiltração com pingos constantes caindo sobre a vaga 42 no subsolo 2";
        ResultadoTriagem = null;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void PresetSomAlto()
    {
        FotoUrl = null;
        AudioUrl = "https://storage.smartcondo.com/audio/gravacao-som-alto-504.mp3";
        RelatoTexto = "Música alta e gritaria no apartamento 504 passando da 1h da manhã";
        ResultadoTriagem = null;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void PresetLampada()
    {
        FotoUrl = "https://storage.smartcondo.com/evidences/lampada-queimada-hall.jpg";
        AudioUrl = null;
        RelatoTexto = "Lâmpada queimada no hall do 3º andar do Bloco A";
        ResultadoTriagem = null;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private async Task AnalisarSemSalvar()
    {
        if (string.IsNullOrWhiteSpace(FotoUrl) && string.IsNullOrWhiteSpace(AudioUrl) && string.IsNullOrWhiteSpace(RelatoTexto))
        {
            ErrorMessage = "Informe ao menos uma foto, áudio ou relato textual para a triagem.";
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;
        IsAnalyzing = true;

        try
        {
            var req = new TriagemOcorrenciaRequestDto(
                FotoUrl: FotoUrl,
                AudioUrl: AudioUrl,
                RelatoTexto: RelatoTexto
            );

            var res = await AiClient.AnalisarTriagemOcorrenciaAsync(req);
            if (res != null && res.IsSuccess && res.Data != null)
            {
                ResultadoTriagem = res.Data;
            }
            else
            {
                ErrorMessage = res?.Message ?? "Erro ao realizar análise de triagem.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro inesperado: {ex.Message}";
        }
        finally
        {
            IsAnalyzing = false;
        }
    }

    private async Task TriarEAbrirChamado()
    {
        if (string.IsNullOrWhiteSpace(FotoUrl) && string.IsNullOrWhiteSpace(AudioUrl) && string.IsNullOrWhiteSpace(RelatoTexto))
        {
            ErrorMessage = "Informe ao menos uma foto, áudio ou relato textual para a triagem.";
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;
        IsOpening = true;

        try
        {
            var req = new TriagemOcorrenciaRequestDto(
                FotoUrl: FotoUrl,
                AudioUrl: AudioUrl,
                RelatoTexto: RelatoTexto,
                MoradorId: "morador-10",
                MoradorNome: "Morador Residente (Bloco A - 102)"
            );

            var res = await AiClient.ProcessarEAbrirTriagemOcorrenciaAsync(req);
            if (res != null && res.IsSuccess && res.Data != null)
            {
                ResultadoTriagem = res.Data;
                SuccessMessage = "Chamado de ocorrência triado pela IA e registrado no sistema!";
                if (OnSaved.HasDelegate)
                {
                    await OnSaved.InvokeAsync();
                }
            }
            else
            {
                ErrorMessage = res?.Message ?? "Erro ao triar e abrir chamado de ocorrência.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro inesperado: {ex.Message}";
        }
        finally
        {
            IsOpening = false;
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        ResultadoTriagem = null;
        ErrorMessage = null;
        SuccessMessage = null;
        await IsOpenChanged.InvokeAsync(false);
    }
}
