@page "/operacoes/manutencao"
@using SmartCondo.Web.Components.Layout
@layout AppShellLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Modules.Operations.Application.DTOs
@using Modules.Operations.Domain.Enums
@using SmartCondo.Web.Services
@using SmartCondo.Web.Components.Pages.Operations
@inject OperationsApiClient OperationsApi
@inject IJSRuntime JSRuntime

<PageTitle>Manutenção Preventiva - SmartCondo</PageTitle>

<link href="css/maintenance.css" rel="stylesheet" />

<div class="maintenance-container">
    <OperationsNavTabs />

    <!-- Header -->
    <div class="maintenance-header">
        <div>
            <h1><i class="bi bi-tools me-2"></i>Plano de Manutenção Preventiva</h1>
            <p class="text-muted mb-0">Calendário operacional e alertas automáticos para elevadores, bombas, para-raios e geradores.</p>
        </div>
        <button class="btn-stitch-primary" @onclick="AbrirModalNovo">
            <i class="bi bi-plus-lg"></i>Novo Plano
        </button>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm mb-4 d-flex align-items-center justify-content-between">
            <div>
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span>@ErrorMessage</span>
            </div>
            <button class="btn btn-sm btn-outline-danger" @onclick="RecarregarDadosAsync">Tentar Novamente</button>
        </div>
    }

    <!-- KPI Summary Grid -->
    @if (Summary != null)
    {
        <div class="maintenance-kpi-grid">
            <div class="kpi-card">
                <div class="kpi-icon primary"><i class="bi bi-clipboard-check"></i></div>
                <div class="kpi-data">
                    <h3>Total de Planos</h3>
                    <p class="kpi-value">@Summary.Total</p>
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon success"><i class="bi bi-check-circle-fill"></i></div>
                <div class="kpi-data">
                    <h3>Em Dia</h3>
                    <p class="kpi-value">@Summary.EmDia</p>
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon warning"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div class="kpi-data">
                    <h3>Próximas (15 dias)</h3>
                    <p class="kpi-value">@Summary.Proximas</p>
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon danger"><i class="bi bi-x-circle-fill"></i></div>
                <div class="kpi-data">
                    <h3>Atrasadas (Crítico)</h3>
                    <p class="kpi-value">@Summary.Atrasadas</p>
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon info"><i class="bi bi-currency-dollar"></i></div>
                <div class="kpi-data">
                    <h3>Custo Real / Estimado</h3>
                    <p class="kpi-value" style="font-size: 1.1rem;">R$ @Summary.TotalCustoReal.ToString("N2") / R$ @Summary.TotalCustoEstimado.ToString("N2")</p>
                </div>
            </div>
        </div>
    }

    <!-- Filter & View Switcher Toolbar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Buscar por equipamento ou empresa..." @bind="FiltroTexto" @bind:event="oninput" />
                    </div>
                </div>

                <div class="col-md-3">
                    <select class="form-select" @bind="SelectedCategoria">
                        <option value="">Todas as Categorias</option>
                        <option value="@CategoriaManutencao.Elevadores">Elevadores</option>
                        <option value="@CategoriaManutencao.BombasDagua">Bombas d'Água</option>
                        <option value="@CategoriaManutencao.ParaRaios">Para-raios</option>
                        <option value="@CategoriaManutencao.Geradores">Geradores</option>
                        <option value="@CategoriaManutencao.Portoes">Portões Automáticos</option>
                        <option value="@CategoriaManutencao.Incendio">Incêndio</option>
                        <option value="@CategoriaManutencao.Outros">Outros</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select class="form-select" @bind="SelectedStatus">
                        <option value="">Todos os Status</option>
                        <option value="@StatusManutencao.EmDia">Em Dia</option>
                        <option value="@StatusManutencao.Proxima">Próxima (Alerta)</option>
                        <option value="@StatusManutencao.Atrasada">Atrasada (Crítico)</option>
                        <option value="@StatusManutencao.Concluida">Concluída</option>
                    </select>
                </div>

                <div class="col-md-2 text-end">
                    <div class="btn-group" role="group">
                        <button type="button" class="btn @(ModoVisao == "tabela" ? "btn-primary-stitch" : "btn-outline-secondary")" @onclick='() => ModoVisao = "tabela"'>
                            <i class="bi bi-list-task"></i> Lista
                        </button>
                        <button type="button" class="btn @(ModoVisao == "calendario" ? "btn-primary-stitch" : "btn-outline-secondary")" @onclick='() => ModoVisao = "calendario"'>
                            <i class="bi bi-calendar3"></i> Agenda
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    @if (Carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando manutenções...</span>
            </div>
            <p class="text-muted mt-2">Carregando calendário de manutenções...</p>
        </div>
    }
    else if (ModoVisao == "tabela")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Equipamento / Serviço</th>
                                <th>Categoria</th>
                                <th>Periodicidade</th>
                                <th>Próxima Manutenção</th>
                                <th>Empresa / Responsável</th>
                                <th>Status</th>
                                <th>Custo (Est. / Real)</th>
                                <th class="text-end px-3">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!PlanosFiltrados.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        Nenhum plano de manutenção encontrado para os filtros selecionados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var plano in PlanosFiltrados)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold" style="color: #2E5B88;">@plano.Titulo</div>
                                            @if (!string.IsNullOrEmpty(plano.Descricao))
                                            {
                                                <small class="text-muted text-truncate d-block" style="max-width: 250px;">@plano.Descricao</small>
                                            }
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@plano.Categoria</span></td>
                                        <td>@plano.Periodicidade</td>
                                        <td>
                                            <div class="fw-semibold">@plano.DataProximaManutencao.ToString("dd/MM/yyyy")</div>
                                            @if (plano.DataUltimaManutencao.HasValue)
                                            {
                                                <small class="text-muted">Última: @plano.DataUltimaManutencao.Value.ToString("dd/MM/yyyy")</small>
                                            }
                                        </td>
                                        <td>
                                            <div>@(plano.EmpresaContratada ?? "-")</div>
                                            @if (!string.IsNullOrEmpty(plano.ResponsavelTecnico))
                                            {
                                                <small class="text-muted">Tech: @plano.ResponsavelTecnico</small>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge-status @GetStatusCssClass(plano.Status)">
                                                <i class="@GetStatusIcon(plano.Status)"></i>
                                                @GetStatusText(plano.Status)
                                            </span>
                                        </td>
                                        <td>
                                            <small class="d-block">Est: R$ @(plano.CustoEstimado?.ToString("N2") ?? "-")</small>
                                            <small class="d-block text-success fw-bold">Real: R$ @(plano.CustoReal?.ToString("N2") ?? "-")</small>
                                        </td>
                                        <td class="text-end px-3">
                                            <button class="btn btn-sm btn-outline-success me-1" title="Registrar Conclusão" @onclick="() => AbrirModalBaixa(plano)">
                                                <i class="bi bi-check-lg"></i> Dar Baixa
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => AbrirModalEdicao(plano)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Visão de Calendário Mensal -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-calendar-event me-2"></i>Calendário de Manutenções do Mês</h5>
                    <span class="badge bg-light text-dark">@DateTime.Today.ToString("MMMM yyyy").ToUpper()</span>
                </div>

                <div class="calendar-view-grid">
                    <div class="calendar-day-header">Dom</div>
                    <div class="calendar-day-header">Seg</div>
                    <div class="calendar-day-header">Ter</div>
                    <div class="calendar-day-header">Qua</div>
                    <div class="calendar-day-header">Qui</div>
                    <div class="calendar-day-header">Sex</div>
                    <div class="calendar-day-header">Sáb</div>

                    @for (int i = 1; i <= 31; i++)
                    {
                        var dia = i;
                        var eventosDoDia = PlanosFiltrados.Where(p => p.DataProximaManutencao.Day == dia).ToList();

                        <div class="calendar-day-cell @(dia == DateTime.Today.Day ? "bg-light border-primary" : "")">
                            <div class="calendar-day-number">@dia</div>
                            @foreach (var ev in eventosDoDia)
                            {
                                <div class="calendar-event-pill @GetStatusCssClass(ev.Status)" title="@ev.Titulo (@ev.EmpresaContratada)">
                                    <strong>@ev.Categoria:</strong> @ev.Titulo
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Modais Interativos -->
<NewMaintenancePlanModal Show="ModalNovoExibir" PlanoParaEditar="PlanoEmEdicao" OnSaved="RecarregarDadosAsync" OnClosed="() => ModalNovoExibir = false" />
<CompleteMaintenanceModal Show="ModalBaixaExibir" Plano="PlanoEmBaixa" OnCompleted="RecarregarDadosAsync" OnClosed="() => ModalBaixaExibir = false" />

@code {
    private List<PlanoManutencaoDto> Planos { get; set; } = new();
    private PlanoManutencaoSummaryDto? Summary { get; set; }
    private bool Carregando { get; set; } = true;
    private string ModoVisao { get; set; } = "tabela";
    private string? ErrorMessage { get; set; }

    private string FiltroTexto { get; set; } = string.Empty;
    private string SelectedCategoria { get; set; } = string.Empty;
    private string SelectedStatus { get; set; } = string.Empty;

    private bool ModalNovoExibir { get; set; }
    private PlanoManutencaoDto? PlanoEmEdicao { get; set; }

    private bool ModalBaixaExibir { get; set; }
    private PlanoManutencaoDto? PlanoEmBaixa { get; set; }

    private List<PlanoManutencaoDto> PlanosFiltrados
    {
        get
        {
            var query = Planos.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(FiltroTexto))
            {
                query = query.Where(p => p.Titulo.Contains(FiltroTexto, StringComparison.OrdinalIgnoreCase)
                                      || (p.EmpresaContratada != null && p.EmpresaContratada.Contains(FiltroTexto, StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrWhiteSpace(SelectedCategoria) && Enum.TryParse<CategoriaManutencao>(SelectedCategoria, out var cat))
            {
                query = query.Where(p => p.Categoria == cat);
            }

            if (!string.IsNullOrWhiteSpace(SelectedStatus) && Enum.TryParse<StatusManutencao>(SelectedStatus, out var status))
            {
                query = query.Where(p => p.Status == status);
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await RecarregarDadosAsync();
    }

    private async Task RecarregarDadosAsync()
    {
        Carregando = true;
        ErrorMessage = null;

        try
        {
            var resultList = await OperationsApi.GetMaintenancePlansAsync(condoId: 1);
            if (resultList.IsSuccess && resultList.Data != null)
            {
                Planos = resultList.Data.ToList();
            }
            else if (!resultList.IsSuccess && !string.IsNullOrEmpty(resultList.Message))
            {
                ErrorMessage = resultList.Message;
            }

            var resultSummary = await OperationsApi.GetMaintenanceSummaryAsync(condoId: 1);
            if (resultSummary.IsSuccess && resultSummary.Data != null)
            {
                Summary = resultSummary.Data;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Falha ao carregar manutenções: {ex.Message}";
        }
        finally
        {
            Carregando = false;
        }
    }

    private void AbrirModalNovo()
    {
        PlanoEmEdicao = null;
        ModalNovoExibir = true;
    }

    private void AbrirModalEdicao(PlanoManutencaoDto plano)
    {
        PlanoEmEdicao = plano;
        ModalNovoExibir = true;
    }

    private void AbrirModalBaixa(PlanoManutencaoDto plano)
    {
        PlanoEmBaixa = plano;
        ModalBaixaExibir = true;
    }

    private static string GetStatusCssClass(StatusManutencao status) => status switch
    {
        StatusManutencao.EmDia => "em-dia",
        StatusManutencao.Proxima => "proxima",
        StatusManutencao.Atrasada => "atrasada",
        StatusManutencao.EmExecucao => "em-execucao",
        StatusManutencao.Concluida => "concluida",
        _ => "em-dia"
    };

    private static string GetStatusIcon(StatusManutencao status) => status switch
    {
        StatusManutencao.EmDia => "bi bi-check-circle",
        StatusManutencao.Proxima => "bi bi-exclamation-triangle",
        StatusManutencao.Atrasada => "bi bi-x-circle",
        StatusManutencao.EmExecucao => "bi bi-gear",
        StatusManutencao.Concluida => "bi bi-check2-all",
        _ => "bi bi-info-circle"
    };

    private static string GetStatusText(StatusManutencao status) => status switch
    {
        StatusManutencao.EmDia => "Em Dia",
        StatusManutencao.Proxima => "Próxima (15 dias)",
        StatusManutencao.Atrasada => "Atrasada",
        StatusManutencao.EmExecucao => "Em Execução",
        StatusManutencao.Concluida => "Concluída",
        _ => status.ToString()
    };
}
