@page "/whatsapp"
@layout AppShellLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthSession Session
@inject NavigationManager Navigation

<PageTitle>ZapCond - WhatsApp / IA</PageTitle>

<div class="p-4 text-center">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Carregando Módulo de WhatsApp...</span>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Session.EnsureLoadedAsync();

        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        if (Session.Context is null)
        {
            Navigation.NavigateTo("/selecionar-perfil", replace: true);
            return;
        }

        Navigation.NavigateTo("/whatsapp/instances", replace: true);
    }
}
