@page "/portaria"
@layout AppShellLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthSession Session
@inject NavigationManager Navigation

<PageTitle>ZapCond - Portaria</PageTitle>

@if (!_sessionReady)
{
    <p>Carregando...</p>
}
else
{
    <ModuleStub Title="Portaria"
                Description="Controle de visitantes, prestadores e encomendas estará disponível em breve."
                Icon="badge" />
}

@code {
    private bool _sessionReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionReady)
        {
            return;
        }

        await Session.EnsureLoadedAsync();

        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        if (Session.Context is null)
        {
            Navigation.NavigateTo("/selecionar-perfil", replace: true);
            return;
        }

        _sessionReady = true;
        Navigation.NavigateTo("/portaria/visitantes", replace: true);
    }
}
