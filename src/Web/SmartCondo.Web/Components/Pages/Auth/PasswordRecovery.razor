@page "/recuperar-senha"
@layout AuthLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthApiClient AuthApi
@inject IConfiguration Configuration

<PageTitle>ZapCond - Recuperar Senha</PageTitle>

<div class="auth-card auth-card-relative">
    @if (!_showSuccess)
    {
        <div class="auth-logo">
            <img src="images/auth/zapcond-logo.png" alt="ZapCond Refuge Logo" />
        </div>
        <div class="auth-title">
            <h2>Recuperar Senha</h2>
            <p>Insira o e-mail associado à sua conta e enviaremos um link para redefinir sua senha.</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="auth-error-banner" role="alert">
                <span class="material-symbols-outlined">error</span>
                <span>@_errorMessage</span>
            </div>
        }

        <EditForm Model="_model" FormName="forgot-password" OnSubmit="HandleSubmitAsync">
            <div class="auth-field">
                <label for="email">E-mail</label>
                <InputText id="email" @bind-Value="_model.Email" class="auth-input" placeholder="seu.email@exemplo.com" style="padding-left:1rem;" />
            </div>
            <button class="btn-primary" type="submit" disabled="@_isSubmitting">Recuperar Senha</button>
            <p style="text-align:center;margin-top:1rem;">
                <a class="auth-link" href="/login">Voltar para o Login</a>
            </p>
        </EditForm>
    }
    else
    {
        <div class="success-overlay" style="position:relative;inset:auto;">
            <div class="success-icon">
                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">check_circle</span>
            </div>
            <h2>Verifique seu e-mail</h2>
            <p>E-mail enviado! Verifique sua caixa de entrada para redefinir sua senha com segurança.</p>
            <button class="auth-link" style="background:none;border:none;cursor:pointer;margin-top:1rem;" @onclick="ResetForm">Tentar outro e-mail</button>
        </div>
    }
</div>

@code {
    private readonly ForgotModel _model = new();
    private bool _showSuccess;
    private bool _isSubmitting;
    private string? _errorMessage;

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Email) || !_model.Email.Contains('@'))
        {
            _errorMessage = "Informe um e-mail válido.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var result = await AuthApi.ForgotPasswordAsync(_model.Email.Trim());
            if (!result.IsSuccess)
            {
                _errorMessage = result.StatusCode == 0
                    ? result.Message
                    : string.IsNullOrWhiteSpace(result.Message)
                        ? "Não foi possível processar a solicitação."
                        : result.Message;
                return;
            }

            _showSuccess = true;
        }
        catch (Exception)
        {
            var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "API";
            _errorMessage = $"Erro inesperado ao conectar com a API em {apiBaseUrl}.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        _showSuccess = false;
        _model.Email = string.Empty;
    }

    private sealed class ForgotModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
