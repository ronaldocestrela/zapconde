@page "/sem-tenant"
@layout AppShellLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>ZapCond - Sem tenant ativo</PageTitle>

<section class="tenant-empty-state">
    <span class="material-symbols-outlined" style="font-size:3rem;color:#0f436f;">domain_disabled</span>
    <h2>Sem tenant ativo</h2>
    <p>Você ainda não possui um condomínio vinculado ou o contexto de acesso expirou. Solicite acesso à administradora para continuar.</p>
    <a class="tenant-empty-cta" href="/selecionar-perfil">
        <span class="material-symbols-outlined">link</span>
        Solicitar Acesso ou Vincular Condomínio
    </a>
</section>
