@page "/financeiro/prestacao-contas"
@layout AppShellLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Modules.Financial.Application.DTOs
@using Modules.Financial.Domain.Enums
@using SmartCondo.Web.Services
@inject FinancialApiClient FinancialApi

<PageTitle>Prestação de Contas Digital - SmartCondo</PageTitle>

<div class="container-fluid p-4">
    <FinancialNavTabs />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 font-weight-bold" style="color: #2E5B88;">
                <span class="material-symbols-outlined align-middle me-2">folder_shared</span>
                Pasta Digital de Prestação de Contas
            </h1>
            <p class="text-muted small mb-0">Prestação de contas mensal com balancete discriminado, comprovantes e aprovação do conselho.</p>
        </div>
        <button class="btn text-white px-3 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2" style="background-color: #2E5B88;" @onclick="GerarNovaPasta">
            <span class="material-symbols-outlined">add</span>
            Gerar Pasta Mensal
        </button>
    </div>

    @if (Carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Carregando pastas digitais...</p>
        </div>
    }
    else if (Pastas.Any())
    {
        <div class="row">
            @foreach (var pasta in Pastas)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm border-0 rounded-3 h-100">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge px-3 py-2 rounded-pill @GetStatusBadgeClass(pasta.Status)">
                                        @pasta.Status
                                    </span>
                                    <span class="text-muted small">@pasta.Mes/@pasta.Ano</span>
                                </div>
                                <h5 class="font-weight-bold text-dark mb-3">Pasta Digital @pasta.Mes/@pasta.Ano</h5>
                                <div class="p-3 bg-light rounded-3 mb-3">
                                    <div class="d-flex justify-content-between text-success mb-1">
                                        <small>Receitas:</small>
                                        <strong>R$ @pasta.TotalReceitas.ToString("N2")</strong>
                                    </div>
                                    <div class="d-flex justify-content-between text-danger mb-1">
                                        <small>Despesas:</small>
                                        <strong>R$ @pasta.TotalDespesas.ToString("N2")</strong>
                                    </div>
                                    <hr class="my-2" />
                                    <div class="d-flex justify-content-between text-primary font-weight-bold">
                                        <small>Saldo Acumulado:</small>
                                        <strong>R$ @pasta.SaldoAcumulado.ToString("N2")</strong>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(pasta.ResumoExecutivoIa))
                                {
                                    <p class="small text-muted mb-0"><span class="material-symbols-outlined align-middle me-1 small text-info">auto_awesome</span> @pasta.ResumoExecutivoIa</p>
                                }
                            </div>

                            <div class="mt-4 pt-2 border-top d-flex gap-2">
                                @if (pasta.Status == StatusPastaDigital.Rascunho)
                                {
                                    <button class="btn btn-outline-primary btn-sm flex-fill" @onclick="() => SubmeterPasta(pasta.Id)">
                                        Submeter Conselho
                                    </button>
                                }
                                else if (pasta.Status == StatusPastaDigital.EmAnaliseConselho)
                                {
                                    <button class="btn btn-success btn-sm flex-fill" @onclick="() => AprovarPasta(pasta.Id)">
                                        Aprovar
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3 p-5 text-center">
            <span class="material-symbols-outlined display-4 text-muted mb-3">folder_open</span>
            <h5 class="text-muted">Nenhuma pasta digital encontrada para este condomínio</h5>
            <p class="small text-muted mb-4">Clique no botão abaixo para iniciar a prestação de contas do mês atual.</p>
            <div>
                <button class="btn text-white px-4 py-2 rounded-3" style="background-color: #2E5B88;" @onclick="GerarNovaPasta">
                    Gerar Pasta do Mês
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool Carregando = true;
    private List<PastaDigitalDto> Pastas = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarPastas();
    }

    private async Task CarregarPastas()
    {
        Carregando = true;
        var result = await FinancialApi.GetDigitalBindersAsync(condoId: 1);
        if (result.IsSuccess && result.Data != null)
        {
            Pastas = result.Data.ToList();
        }
        Carregando = false;
    }

    private async Task GerarNovaPasta()
    {
        var req = new CriarPastaDigitalRequestDto(1, DateTime.Now.Year, DateTime.Now.Month, 5000m, "Prestação de contas mensal gerada automaticamente.");
        await FinancialApi.CreateDigitalBinderAsync(req);
        await CarregarPastas();
    }

    private async Task SubmeterPasta(int id)
    {
        await FinancialApi.SubmitDigitalBinderAsync(id);
        await CarregarPastas();
    }

    private async Task AprovarPasta(int id)
    {
        await FinancialApi.ApproveDigitalBinderAsync(id, new AprovarPastaDigitalRequestDto(1, "Aprovado sem ressalvas pelo Conselho Fiscal."));
        await CarregarPastas();
    }

    private static string GetStatusBadgeClass(StatusPastaDigital status) => status switch
    {
        StatusPastaDigital.Rascunho => "bg-secondary text-white",
        StatusPastaDigital.EmAnaliseConselho => "bg-warning text-dark",
        StatusPastaDigital.Aprovada => "bg-success text-white",
        StatusPastaDigital.Publicada => "bg-primary text-white",
        StatusPastaDigital.Rejeitada => "bg-danger text-white",
        _ => "bg-secondary"
    };
}
