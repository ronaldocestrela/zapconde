@page "/financeiro/inadimplencia"
@layout AppShellLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Modules.Financial.Application.Dtos
@using Modules.Financial.Application.Services
@using SmartCondo.Web.Services
@inject FinancialApiClient FinancialApi
@inject IServiceProvider ServiceProvider

<PageTitle>Gestão de Inadimplência e Régua de Cobrança - SmartCondo</PageTitle>

<div class="container-fluid p-4">
    <!-- Sub-Navigation Bar -->
    <FinancialNavTabs />

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 font-weight-bold" style="color: #2E5B88;">
                <span class="material-symbols-outlined align-middle me-2 text-warning">warning_amber</span>
                Gestão de Inadimplência e Régua de Cobrança
            </h1>
            <p class="text-muted small mb-0">Monitoramento da curva de aging, automação de réguas D+N e histórico de disparos.</p>
        </div>
        <button class="btn text-white px-3 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2" 
                style="background-color: #2E5B88;" 
                @onclick="ExecutarReguaEmLote">
            <span class="material-symbols-outlined">play_arrow</span>
            Executar Régua Agora
        </button>
    </div>

    @if (Carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Carregando painel de inadimplência...</p>
        </div>
    }
    else if (Dashboard != null)
    {
        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small d-block mb-1">Taxa de Inadimplência</span>
                    <h3 class="mb-0 font-weight-bold text-danger">@Dashboard.TaxaInadimplenciaPercentual%</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small d-block mb-1">Total Inadimplente</span>
                    <h3 class="mb-0 font-weight-bold text-danger">@Dashboard.ValorTotalInadimplente.ToString("C")</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small d-block mb-1">Recuperado em Acordos</span>
                    <h3 class="mb-0 font-weight-bold text-success">@Dashboard.ValorTotalRecuperadoAcordos.ToString("C")</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small d-block mb-1">Unidades em Atraso</span>
                    <h3 class="mb-0 font-weight-bold text-warning">@Dashboard.AgingList.QuantidadeUnidadesInadimplentes</h3>
                </div>
            </div>
        </div>

        <!-- Aging List Breakdown -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
            <h5 class="font-weight-bold mb-3" style="color: #2E5B88;">
                <span class="material-symbols-outlined align-middle me-2">bar_chart</span>
                Análise por Curva de Atraso (Aging List)
            </h5>
            <div class="row text-center g-3">
                <div class="col-md-3">
                    <div class="p-3 rounded-3" style="background-color: #FFF3CD;">
                        <span class="d-block text-warning font-weight-bold">1 a 30 Dias</span>
                        <h4 class="mb-0 font-weight-bold">@Dashboard.AgingList.TotalVencido1A30Dias.ToString("C")</h4>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded-3" style="background-color: #FFE5D0;">
                        <span class="d-block text-warning font-weight-bold">31 a 60 Dias</span>
                        <h4 class="mb-0 font-weight-bold">@Dashboard.AgingList.TotalVencido31A60Dias.ToString("C")</h4>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded-3" style="background-color: #F8D7DA;">
                        <span class="d-block text-danger font-weight-bold">61 a 90 Dias</span>
                        <h4 class="mb-0 font-weight-bold">@Dashboard.AgingList.TotalVencido61A90Dias.ToString("C")</h4>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded-3" style="background-color: #721C24; color: white;">
                        <span class="d-block text-white-50 font-weight-bold">Acima de 90 Dias</span>
                        <h4 class="mb-0 font-weight-bold text-white">@Dashboard.AgingList.TotalVencidoAcima90Dias.ToString("C")</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Etapas da Régua e Histórico -->
        <div class="row g-4">
            <!-- Etapas da Régua -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <h5 class="font-weight-bold mb-3" style="color: #2E5B88;">
                        <span class="material-symbols-outlined align-middle me-2">alt_route</span>
                        Etapas da Régua Ativas (D+N)
                    </h5>
                    <div class="list-group list-group-flush">
                        @foreach (var etapa in EtapasRegua)
                        {
                            <div class="list-group-item bg-transparent px-0 py-3 border-bottom d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge rounded-pill bg-primary">D+@etapa.DiasAtrasoMinimo</span>
                                        <span class="font-weight-bold text-dark">@etapa.NomeEtapa</span>
                                    </div>
                                    <small class="text-muted">Canal: <strong>@etapa.Canal.ToString()</strong> | Ação: <strong>@etapa.TipoAcao.ToString()</strong></small>
                                </div>
                                <span class="badge bg-success">Ativa</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Últimos Disparos de Cobrança -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <h5 class="font-weight-bold mb-3" style="color: #2E5B88;">
                        <span class="material-symbols-outlined align-middle me-2">history</span>
                        Histórico Recente de Notificações
                    </h5>
                    @if (!Dashboard.UltimosHistoricos.Any())
                    {
                        <p class="text-muted small mb-0">Nenhuma notificação de cobrança disparada recentemente.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Data</th>
                                        <th>Unidade</th>
                                        <th>Canal</th>
                                        <th>Ação</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var hist in Dashboard.UltimosHistoricos)
                                    {
                                        <tr>
                                            <td class="small">@hist.DataExecucao.ToString("dd/MM HH:mm")</td>
                                            <td class="small font-weight-bold">Unidade @hist.UnidadeId</td>
                                            <td class="small">@hist.Canal.ToString()</td>
                                            <td class="small">@hist.TipoAcao.ToString()</td>
                                            <td><span class="badge bg-success">Enviado</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DashboardInadimplenciaDto? Dashboard;
    private List<EtapaReguaDto> EtapasRegua = new();
    private bool Carregando = true;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        Carregando = true;
        var dashRes = await FinancialApi.GetDunningDashboardAsync(1);
        if (dashRes.IsSuccess)
        {
            Dashboard = dashRes.Data;
        }
        else
        {
            var service = ServiceProvider.GetService<IReguaInadimplenciaAppService>();
            if (service != null)
            {
                var res = await service.ObterDashboardInadimplenciaAsync(1);
                if (res.IsSuccess) Dashboard = res.Data;
            }
        }

        var configRes = await FinancialApi.GetDunningConfigAsync(1);
        if (configRes.IsSuccess && configRes.Data != null)
        {
            EtapasRegua = configRes.Data.ToList();
        }
        else
        {
            var service = ServiceProvider.GetService<IReguaInadimplenciaAppService>();
            if (service != null)
            {
                var res = await service.ObterConfiguracaoReguaAsync(1);
                if (res.IsSuccess && res.Data != null) EtapasRegua = res.Data.ToList();
            }
        }

        Carregando = false;
    }

    private async Task ExecutarReguaEmLote()
    {
        var apiRes = await FinancialApi.ProcessDunningAsync(1);
        if (apiRes.IsSuccess)
        {
            await CarregarDados();
            return;
        }

        var service = ServiceProvider.GetService<IReguaInadimplenciaAppService>();
        if (service != null)
        {
            var res = await service.ProcessarReguaCobrancaAsync(1);
            if (res.IsSuccess)
            {
                await CarregarDados();
            }
        }
    }
}
