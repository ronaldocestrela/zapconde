@using Modules.Financial.Application.Dtos
@inject HttpClient Http

@if (IsOpen && PaymentInfo != null)
{
    <div class="modal-backdrop-stitch" @onclick="CloseModal">
        <div class="modal-dialog-stitch" style="max-width: 580px;" @onclick:stopPropagation="true">
            <div class="modal-header-stitch" style="background: linear-gradient(135deg, #2E5B88 0%, #1E3D5B 100%); color: white;">
                <div>
                    <h3 class="m-0 font-semibold text-lg flex items-center gap-2">
                        <span>⚡ Cobrança & PIX</span>
                        <span class="text-xs bg-white/20 px-2 py-0.5 rounded font-normal">@PaymentInfo.Provider</span>
                    </h3>
                    <p class="text-xs text-white/80 m-0">Fatura #@PaymentInfo.FaturaId • Vencimento: @PaymentInfo.DataVencimento.ToString("dd/MM/yyyy")</p>
                </div>
                <button type="button" class="text-white/80 hover:text-white font-bold text-2xl cursor-pointer bg-transparent border-0" @onclick="CloseModal">&times;</button>
            </div>

            <div class="modal-body-stitch p-4">
                <!-- Banner de Status & Valor -->
                <div class="flex items-center justify-between p-3 mb-4 rounded-xl border" style="background: #F8FAFC; border-color: #E2E8F0;">
                    <div>
                        <span class="text-xs text-gray-500 block uppercase tracking-wider font-semibold">Valor Total</span>
                        <span class="text-2xl font-bold font-mono" style="color: #2E5B88;">R$ @PaymentInfo.TotalFinal.ToString("N2")</span>
                    </div>
                    <div class="text-right">
                        <span class="text-xs text-gray-500 block mb-1">Status do Pagamento</span>
                        <span class="@GetStatusBadgeClass(PaymentInfo.StatusBoleto)">@PaymentInfo.StatusBoleto</span>
                    </div>
                </div>

                <!-- Tabs de Pagamento (PIX vs Boleto) -->
                <div class="flex border-b border-gray-200 mb-4">
                    <button type="button" class="py-2 px-4 font-medium text-sm border-b-2 bg-transparent border-0 cursor-pointer transition-colors @(ActiveTab == "pix" ? "border-blue-600 text-blue-600 font-semibold" : "border-transparent text-gray-500 hover:text-gray-700")"
                            @onclick='() => ActiveTab = "pix"'>
                        📱 PIX (QR Code & Copia e Cola)
                    </button>
                    <button type="button" class="py-2 px-4 font-medium text-sm border-b-2 bg-transparent border-0 cursor-pointer transition-colors @(ActiveTab == "boleto" ? "border-blue-600 text-blue-600 font-semibold" : "border-transparent text-gray-500 hover:text-gray-700")"
                            @onclick='() => ActiveTab = "boleto"'>
                        📄 Boleto Bancário
                    </button>
                </div>

                @if (ActiveTab == "pix")
                {
                    <div class="text-center p-2">
                        @if (!string.IsNullOrWhiteSpace(PaymentInfo.PixQrCodeBase64))
                        {
                            <div class="inline-block p-3 bg-white border border-gray-200 rounded-xl shadow-sm mb-3">
                                <img src="@PaymentInfo.PixQrCodeBase64" alt="QR Code PIX" style="width: 180px; height: 180px;" />
                            </div>
                        }

                        <div class="mb-3 text-left">
                            <label class="text-xs font-semibold text-gray-600 block mb-1">Chave PIX Copia e Cola</label>
                            <div class="flex gap-2">
                                <input type="text" readonly class="flex-1 font-mono text-xs p-2.5 bg-gray-50 border border-gray-300 rounded-lg text-gray-800"
                                       value="@PaymentInfo.CodigoPixCopiaECola" />
                                <button type="button" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg border-0 cursor-pointer transition-colors shadow-sm"
                                        @onclick="CopyPixToClipboard">
                                    @(CopiedPix ? "✓ Copiado!" : "Copiar")
                                </button>
                            </div>
                        </div>

                        <p class="text-xs text-gray-500 m-0">Abra o aplicativo do seu banco, escolha a opção <strong>PIX</strong> e escaneie o código acima ou cole a chave.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-4 p-2">
                        <div>
                            <label class="text-xs font-semibold text-gray-600 block mb-1">Linha Digitável</label>
                            <div class="flex gap-2">
                                <input type="text" readonly class="flex-1 font-mono text-xs p-2.5 bg-gray-50 border border-gray-300 rounded-lg text-gray-800"
                                       value="@PaymentInfo.LinhaDigitavel" />
                                <button type="button" class="px-4 py-2 bg-gray-700 hover:bg-gray-800 text-white text-xs font-semibold rounded-lg border-0 cursor-pointer transition-colors"
                                        @onclick="CopyLinhaToClipboard">
                                    @(CopiedLinha ? "✓ Copiado!" : "Copiar")
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(PaymentInfo.PdfUrl))
                        {
                            <div class="pt-2">
                                <a href="@PaymentInfo.PdfUrl" target="_blank" class="inline-flex items-center justify-center gap-2 w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg text-decoration-none shadow-sm transition-colors">
                                    <span>📥 Download / Visualizar PDF do Boleto</span>
                                </a>
                            </div>
                        }
                    </div>
                }

                <!-- Rodapé de Sincronização & Fechamento -->
                <div class="flex items-center justify-between pt-4 mt-4 border-t border-gray-200 text-xs text-gray-500">
                    <div>
                        @if (PaymentInfo.DataUltimaSincronizacao.HasValue)
                        {
                            <span>Última sync: @PaymentInfo.DataUltimaSincronizacao.Value.ToString("HH:mm:ss")</span>
                        }
                    </div>

                    <div class="flex gap-2">
                        <button type="button" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium border-0 cursor-pointer transition-colors"
                                disabled="@IsSyncing" @onclick="OnSyncClick">
                            @(IsSyncing ? "Sincronizando..." : "🔄 Sincronizar Agora")
                        </button>
                        <button type="button" class="px-4 py-1.5 bg-gray-800 hover:bg-gray-900 text-white rounded-lg font-medium border-0 cursor-pointer transition-colors"
                                @onclick="CloseModal">
                            Fechar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public PaymentInfoResponseDto? PaymentInfo { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnSyncRequested { get; set; }

    private string ActiveTab { get; set; } = "pix";
    private bool CopiedPix { get; set; }
    private bool CopiedLinha { get; set; }
    private bool IsSyncing { get; set; }

    private async Task CloseModal()
    {
        CopiedPix = false;
        CopiedLinha = false;
        await OnClose.InvokeAsync();
    }

    private void CopyPixToClipboard()
    {
        CopiedPix = true;
    }

    private void CopyLinhaToClipboard()
    {
        CopiedLinha = true;
    }

    private async Task OnSyncClick()
    {
        if (PaymentInfo != null)
        {
            IsSyncing = true;
            await OnSyncRequested.InvokeAsync(PaymentInfo.FaturaId);
            IsSyncing = false;
        }
    }

    private string GetStatusBadgeClass(string status) => status?.ToUpperInvariant() switch
    {
        "PAGO" or "RECEIVED" or "CONFIRMED" => "badge-status badge-pago",
        "PENDENTE" or "GERADO" or "PENDING" => "badge-status badge-pendente",
        "VENCIDO" or "OVERDUE" => "badge-status badge-vencido",
        _ => "badge-status badge-cancelado"
    };
}
