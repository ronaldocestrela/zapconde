@page "/configuracoes"
@layout AppShellLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthSession Session
@inject NavigationManager Navigation

<PageTitle>ZapCond - Configurações</PageTitle>

@if (!_sessionReady)
{
    <p>Carregando...</p>
}
else
{
    <ModuleStub Title="Configurações"
                Description="Preferências da conta, notificações e integrações estarão disponíveis em breve."
                Icon="settings" />
}

@code {
    private bool _sessionReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionReady)
        {
            return;
        }

        await Session.EnsureLoadedAsync();

        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        if (Session.Context is null)
        {
            Navigation.NavigateTo("/selecionar-perfil", replace: true);
            return;
        }

        _sessionReady = true;
        StateHasChanged();
    }
}
