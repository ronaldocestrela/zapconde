@page "/whatsapp/logs"
@layout AppShellLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Modules.WhatsApp.Application.DTOs
@using SmartCondo.Web.Services
@inject WhatsAppApiClient WhatsAppApi
@inject NavigationManager Navigation
@inject AuthSession Session

<PageTitle>Logs de Webhooks - WhatsApp</PageTitle>

<link href="css/whatsapp.css" rel="stylesheet" />

<div class="whatsapp-container">
    <WhatsAppNavTabs />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 font-weight-bold" style="color: #2E5B88;">
                <span class="material-symbols-outlined align-middle me-2">receipt_long</span>
                Logs de Recepção de Webhooks
            </h1>
            <p class="text-muted small mb-0">Rastreabilidade completa de todas as mensagens recebidas via Evolution API com checagem de idempotência.</p>
        </div>
        <button class="btn btn-outline-primary d-flex align-items-center gap-2" @onclick="CarregarLogsAsync">
            <span class="material-symbols-outlined">refresh</span>
            Atualizar Logs
        </button>
    </div>

    <!-- Barra de Filtros -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <span class="material-symbols-outlined text-muted">search</span>
                        </span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por telefone ou remetente..."
                               @bind="_filtroTelefone" @bind:event="oninput" @onkeyup="OnKeyFilter" />
                    </div>
                </div>

                <div class="col-md-3">
                    <select class="form-select" @bind="_filtroStatus" @bind:after="CarregarLogsAsync">
                        <option value="">Todos os Status</option>
                        <option value="Received">Received (Recebido)</option>
                        <option value="Processed">Processed (Processado)</option>
                        <option value="Ignored">Ignored (Idempotência)</option>
                        <option value="Failed">Failed (Falha)</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="Instância (ex: condo-central)..."
                           @bind="_filtroInstancia" @bind:event="oninput" @onkeyup="OnKeyFilter" />
                </div>

                <div class="col-md-2 text-end">
                    <button class="btn btn-secondary w-100" @onclick="LimparFiltros">Limpar</button>
                </div>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p class="text-muted mt-2">Carregando logs de webhooks...</p>
        </div>
    }
    else if (Logs == null || !Logs.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center" style="border-radius: 14px;">
            <span class="material-symbols-outlined display-3 text-muted mb-3">inbox</span>
            <h5 class="fw-bold text-dark">Nenhum log encontrado</h5>
            <p class="text-muted mb-0">Nenhuma requisição de webhook foi recebida ainda para os filtros aplicados.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm" style="border-radius: 14px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Data / Hora</th>
                            <th>Instância</th>
                            <th>Remetente</th>
                            <th>Tipo</th>
                            <th>Conteúdo Extraído</th>
                            <th>Status Ingestão</th>
                            <th>Fila MassTransit</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Logs)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold text-dark">@log.ReceivedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@log.InstanceName</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark d-block">@log.SenderPhone</span>
                                    <small class="text-muted">@(log.PushName ?? "-")</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@log.MessageType</span>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 250px;" title="@log.MessageText">
                                        @(string.IsNullOrWhiteSpace(log.MessageText) ? "(sem texto)" : log.MessageText)
                                    </span>
                                </td>
                                <td>
                                    <span class="wpp-badge-status @GetBadgeStatusClass(log.Status)">
                                        @log.Status
                                    </span>
                                </td>
                                <td>
                                    @if (log.Status == "Received" || log.Status == "Processed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success d-inline-flex align-items-center gap-1">
                                            <span class="material-symbols-outlined fs-6">published_with_changes</span>
                                            Enfileirado (Outbox)
                                        </span>
                                    }
                                    else if (log.Status == "Ignored")
                                    {
                                        <span class="badge bg-light text-muted border">Ignorado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border">Falha</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                            @onclick="() => AbrirModalDetalhes(log)">
                                        <span class="material-symbols-outlined fs-6">visibility</span>
                                        JSON
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (_logSelecionado != null)
{
    <WebhookDetailModal Log="_logSelecionado" OnClose="() => _logSelecionado = null" />
}

@code {
    private bool _loading = true;
    private string? _filtroTelefone;
    private string? _filtroStatus;
    private string? _filtroInstancia;

    private List<WhatsAppWebhookLogDto>? Logs;
    private WhatsAppWebhookLogDto? _logSelecionado;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Session.EnsureLoadedAsync();
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        await CarregarLogsAsync();
        _loading = false;
        StateHasChanged();
    }

    private async Task CarregarLogsAsync()
    {
        var result = await WhatsAppApi.GetWebhookLogsAsync(
            instanceName: _filtroInstancia,
            status: _filtroStatus,
            phone: _filtroTelefone,
            page: 1,
            pageSize: 50
        );

        if (result != null && result.IsSuccess)
        {
            Logs = result.Data?.ToList();
        }
    }

    private async Task OnKeyFilter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CarregarLogsAsync();
        }
    }

    private async Task LimparFiltros()
    {
        _filtroTelefone = null;
        _filtroStatus = null;
        _filtroInstancia = null;
        await CarregarLogsAsync();
    }

    private void AbrirModalDetalhes(WhatsAppWebhookLogDto log)
    {
        _logSelecionado = log;
    }

    private static string GetBadgeStatusClass(string status) => status switch
    {
        "Received" => "wpp-badge-received",
        "Processed" => "wpp-badge-processed",
        "Failed" => "wpp-badge-failed",
        "Ignored" => "wpp-badge-ignored",
        _ => "bg-secondary text-white"
    };
}
