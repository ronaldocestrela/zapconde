@using Modules.WhatsApp.Application.DTOs
@using SmartCondo.Web.Services
@inject WhatsAppApiClient WhatsAppApi

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header" style="background-color: #2E5B88; color: white; border-top-left-radius: 16px; border-top-right-radius: 16px;">
                <h5 class="modal-header-title m-0 fw-bold d-flex align-items-center gap-2" style="color: white;">
                    <span class="material-symbols-outlined">add_link</span>
                    Nova Instância Evolution API
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="OnClose"></button>
            </div>
            <EditForm Model="_model" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />
                <div class="modal-body p-4">
                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="alert alert-danger mb-3" role="alert">
                            @_errorMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nome da Instância (Identificador Único) *</label>
                        <InputText @bind-Value="_model.InstanceName" class="form-control" placeholder="ex: condo-central" />
                        <small class="text-muted">Use o mesmo nome de instância configurado na Evolution API.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Provedor API *</label>
                        <InputSelect @bind-Value="_model.Provider" class="form-select">
                            <option value="EvolutionApi">Evolution API (Recomendado)</option>
                            <option value="ZApi">Z-API</option>
                            <option value="Twilio">Twilio WhatsApp</option>
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">URL Base da API Evolution *</label>
                        <InputText @bind-Value="_model.BaseUrl" class="form-control" placeholder="https://api.evolution.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chave de API (ApiKey) *</label>
                        <InputText @bind-Value="_model.ApiKey" class="form-control" type="password" placeholder="Sua chave de acesso global ou de instância" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Webhook Secret (Opcional)</label>
                        <InputText @bind-Value="_model.WebhookSecret" class="form-control" placeholder="Token secreto para validação" />
                    </div>
                </div>

                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button type="button" class="btn btn-outline-secondary" @onclick="OnClose" disabled="@_saving">Cancelar</button>
                    <button type="submit" class="btn text-white fw-bold d-flex align-items-center gap-2" style="background-color: #2E5B88;" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Salvando...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">save</span>
                            <span>Cadastrar Instância</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public int CondoId { get; set; } = 1;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private InstanceFormModel _model = new();
    private bool _saving;
    private string? _errorMessage;

    private async Task SalvarAsync()
    {
        _saving = true;
        _errorMessage = null;

        var cmd = new CreateWhatsAppInstanceCommand(
            CondoId: CondoId,
            InstanceName: _model.InstanceName,
            Provider: _model.Provider,
            BaseUrl: _model.BaseUrl,
            ApiKey: _model.ApiKey,
            WebhookSecret: _model.WebhookSecret
        );

        var result = await WhatsAppApi.CreateInstanceAsync(cmd);
        _saving = false;

        if (result != null && result.IsSuccess)
        {
            await OnSaved.InvokeAsync();
        }
        else
        {
            _errorMessage = result?.Message ?? "Ocorreu um erro ao cadastrar a instância de WhatsApp.";
        }
    }

    private class InstanceFormModel
    {
        public string InstanceName { get; set; } = string.Empty;
        public string Provider { get; set; } = "EvolutionApi";
        public string BaseUrl { get; set; } = "https://api.evolution.com";
        public string ApiKey { get; set; } = string.Empty;
        public string? WebhookSecret { get; set; }
    }
}
