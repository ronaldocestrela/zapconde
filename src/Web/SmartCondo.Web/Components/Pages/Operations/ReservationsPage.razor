@page "/operacoes/reservas"
@layout AppShellLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Modules.Operations.Application.DTOs
@using Modules.Operations.Domain.Enums
@using SmartCondo.Web.Services
@inject OperationsApiClient OperationsApi
@inject NavigationManager NavigationManager

<PageTitle>Gerenciamento de Reservas - Smart Condo</PageTitle>

<div class="container-fluid px-4 py-4">
    <!-- Navegação de Abas das Operações -->
    <OperationsNavTabs />

    <!-- Sub-cabeçalho da página de Reservas -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #2E5B88;">Agendamentos e Reservas de Áreas Comuns</h2>
            <p class="text-muted mb-0">Controle de ocupação, aprovações de síndico e prevenção de colisão de horários.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary d-flex align-items-center gap-1" @onclick="RecarregarDados">
                <span class="material-symbols-outlined fs-5">refresh</span> Atualizar
            </button>
            <button class="res-btn-primary d-flex align-items-center gap-2" @onclick="AbrirModalNovaReserva">
                <span class="material-symbols-outlined fs-5">add_circle</span> Solicitar Nova Reserva
            </button>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="res-kpi-card">
                <div class="res-kpi-icon">
                    <span class="material-symbols-outlined">event_note</span>
                </div>
                <div>
                    <div class="res-kpi-label">Reservas no Mês</div>
                    <div class="res-kpi-val">@(Resumo?.TotalReservasMes ?? 0)</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="res-kpi-card">
                <div class="res-kpi-icon text-warning" style="background-color: #fff8e6;">
                    <span class="material-symbols-outlined">pending_actions</span>
                </div>
                <div>
                    <div class="res-kpi-label">Pendentes de Aprovação</div>
                    <div class="res-kpi-val text-warning">@(Resumo?.ReservasPendentes ?? 0)</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="res-kpi-card">
                <div class="res-kpi-icon text-success" style="background-color: #e6f4ea;">
                    <span class="material-symbols-outlined">verified</span>
                </div>
                <div>
                    <div class="res-kpi-label">Confirmadas</div>
                    <div class="res-kpi-val text-success">@(Resumo?.ReservasConfirmadas ?? 0)</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="res-kpi-card">
                <div class="res-kpi-icon text-primary" style="background-color: #e8f0fe;">
                    <span class="material-symbols-outlined">payments</span>
                </div>
                <div>
                    <div class="res-kpi-label">Receita Estimada</div>
                    <div class="res-kpi-val">R$ @((Resumo?.ReceitaTotalReservas ?? 0m).ToString("N2"))</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Filtrar por Área Comum</label>
                    <select class="form-select" @bind="FiltroAreaId" @bind:after="Filtrar">
                        <option value="">Todas as Áreas Comuns</option>
                        @foreach (var area in AreasComuns)
                        {
                            <option value="@area.Id">@area.Nome (@area.Tipo)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Status da Reserva</label>
                    <select class="form-select" @bind="FiltroStatus" @bind:after="Filtrar">
                        <option value="">Todos os Status</option>
                        <option value="@StatusReserva.Confirmada">Confirmadas</option>
                        <option value="@StatusReserva.PendenteAprovacao">Pendentes</option>
                        <option value="@StatusReserva.Cancelada">Canceladas</option>
                        <option value="@StatusReserva.Rejeitada">Rejeitadas</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Data da Reserva</label>
                    <input type="date" class="form-control" @bind="FiltroData" @bind:after="Filtrar" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-light w-100 fw-semibold" @onclick="LimparFiltros">Limpar Filtros</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Agendamentos -->
    <div class="res-card-table">
        @if (Carregando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Carregando agendamentos...</span>
                </div>
                <p class="mt-2 text-muted">Carregando lista de reservas...</p>
            </div>
        }
        else if (Reservas == null || !Reservas.Any())
        {
            <div class="text-center py-5">
                <span class="material-symbols-outlined display-4 text-muted">event_busy</span>
                <h5 class="mt-3 text-muted">Nenhuma reserva encontrada</h5>
                <p class="text-muted small">Não há agendamentos cadastrados para os filtros selecionados.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Área Comum</th>
                            <th>Morador / Unidade</th>
                            <th>Data & Horário</th>
                            <th class="text-center">Qtd Pessoas</th>
                            <th class="text-end">Valor Total</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Reservas)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold" style="color: #2E5B88;">@res.NomeAreaComum</div>
                                    <div class="small text-muted">Solicitado em @res.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@res.NomeMorador</div>
                                    <span class="badge bg-light text-dark border">@res.UnidadeMorador</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@res.DataInicio.ToString("dd/MM/yyyy")</div>
                                    <div class="small text-muted">@res.DataInicio.ToString("HH:mm") às @res.DataFim.ToString("HH:mm")</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-secondary">
                                        <span class="material-symbols-outlined align-middle fs-6 me-1">groups</span>
                                        @res.QuantidadePessoas
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-success">
                                    R$ @res.ValorTotal.ToString("N2")
                                </td>
                                <td class="text-center">
                                    <span class="@GetBadgeClass(res.Status)">
                                        @GetStatusText(res.Status)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        @if (res.Status == StatusReserva.PendenteAprovacao)
                                        {
                                            <button class="btn btn-outline-success" title="Aprovar Reserva" @onclick="() => Aprovar(res.Id)">
                                                <span class="material-symbols-outlined fs-6 align-middle">check_circle</span>
                                            </button>
                                        }
                                        @if (res.Status == StatusReserva.PendenteAprovacao || res.Status == StatusReserva.Confirmada)
                                        {
                                            <button class="btn btn-outline-danger" title="Cancelar Reserva" @onclick="() => AbrirModalCancelar(res)">
                                                <span class="material-symbols-outlined fs-6 align-middle">cancel</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Wizard de Nova Reserva -->
@if (ExibirModalNovaReserva)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header text-white" style="background-color: #2E5B88;">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined">event_available</span>
                        Solicitar Nova Reserva de Área Comum
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalNovaReserva"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(ErroFormulario))
                    {
                        <div class="res-collision-alert">
                            <span class="material-symbols-outlined fs-4">warning</span>
                            <div>
                                <strong>Não foi possível agendar a reserva:</strong>
                                <div class="small">@ErroFormulario</div>
                            </div>
                        </div>
                    }

                    <form>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Área Comum *</label>
                                <select class="form-select" @bind="FormAreaComumId" @bind:after="AoSelecionarArea">
                                    <option value="0">Selecione uma Área Comum...</option>
                                    @foreach (var area in AreasComuns)
                                    {
                                        <option value="@area.Id">@area.Nome (@area.Tipo)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Morador Solicitante *</label>
                                <input type="text" class="form-control" @bind="FormNomeMorador" placeholder="Nome do Morador" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Unidade *</label>
                                <input type="text" class="form-control" @bind="FormUnidadeMorador" placeholder="Ex: Apt 101 Bloco A" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Qtd de Convidados *</label>
                                <input type="number" class="form-control" @bind="FormQtdPessoas" min="1" max="@(AreaSelecionada?.CapacidadeMaxima ?? 100)" />
                                @if (AreaSelecionada != null)
                                {
                                    <div class="form-text">Máx: @AreaSelecionada.CapacidadeMaxima pessoas</div>
                                }
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Data da Reserva *</label>
                                <input type="date" class="form-control" @bind="FormDataReserva" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Horário Inicial *</label>
                                <input type="time" class="form-control" @bind="FormHoraInicio" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Horário Final *</label>
                                <input type="time" class="form-control" @bind="FormHoraFim" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Observações do Agendamento</label>
                            <textarea class="form-control" rows="2" @bind="FormObservacao" placeholder="Ex: Aniversário infantil, contratação de buffet..."></textarea>
                        </div>

                        <!-- Resumo financeiro calculado em tempo real -->
                        @if (AreaSelecionada != null)
                        {
                            <div class="card bg-light border-0 p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">Resumo de Custos da Reserva:</div>
                                        <div class="small text-muted">
                                            Taxa Reserva: R$ @AreaSelecionada.TaxaReserva.ToString("N2") | Taxa Limpeza: R$ @AreaSelecionada.TaxaLimpeza.ToString("N2")
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="small text-muted">Custo Total:</div>
                                        <div class="fs-4 fw-bold text-success">
                                            R$ @AreaSelecionada.CustoTotalReserva.ToString("N2")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalNovaReserva">Cancelar</button>
                    <button type="button" class="res-btn-primary" @onclick="SalvarReserva" disabled="@ProcessandoFormulario">
                        @if (ProcessandoFormulario)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Reservando com Redis Lock...</span>
                        }
                        else
                        {
                            <span>Confirmar Agendamento</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de Cancelamento de Reserva -->
@if (ReservaParaCancelar != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Cancelar Reserva #@ReservaParaCancelar.Id</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalCancelar"></button>
                </div>
                <div class="modal-body p-4">
                    <p>Tem certeza que deseja cancelar a reserva para <strong>@ReservaParaCancelar.NomeMorador</strong> na área <strong>@ReservaParaCancelar.NomeAreaComum</strong>?</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo do Cancelamento *</label>
                        <textarea class="form-control" rows="3" @bind="MotivoCancelamento" placeholder="Informe o motivo..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalCancelar">Voltar</button>
                    <button type="button" class="btn btn-danger fw-bold" @onclick="ConfirmarCancelamento">Confirmar Cancelamento</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AreaComumDto> AreasComuns { get; set; } = new();
    private List<ReservaDto> Reservas { get; set; } = new();
    private ReservaSummaryDto? Resumo { get; set; }
    private bool Carregando { get; set; } = true;

    // Filtros
    private int? FiltroAreaId { get; set; }
    private StatusReserva? FiltroStatus { get; set; }
    private DateTime? FiltroData { get; set; }

    // Modal Nova Reserva
    private bool ExibirModalNovaReserva { get; set; } = false;
    private bool ProcessandoFormulario { get; set; } = false;
    private string ErroFormulario { get; set; } = string.Empty;

    private int FormAreaComumId { get; set; } = 0;
    private AreaComumDto? AreaSelecionada { get; set; }
    private string FormNomeMorador { get; set; } = "Morador Exemplo";
    private string FormUnidadeMorador { get; set; } = "Apt 101";
    private int FormQtdPessoas { get; set; } = 20;
    private DateTime FormDataReserva { get; set; } = DateTime.Today.AddDays(2);
    private TimeOnly FormHoraInicio { get; set; } = new TimeOnly(14, 0);
    private TimeOnly FormHoraFim { get; set; } = new TimeOnly(18, 0);
    private string FormObservacao { get; set; } = string.Empty;

    // Modal Cancelar Reserva
    private ReservaDto? ReservaParaCancelar { get; set; }
    private string MotivoCancelamento { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await RecarregarDados();
    }

    private async Task RecarregarDados()
    {
        Carregando = true;
        try
        {
            var areasRes = await OperationsApi.GetAreasComunsAsync();
            if (areasRes.IsSuccess && areasRes.Data != null)
            {
                AreasComuns = areasRes.Data.ToList();
            }

            var resumoRes = await OperationsApi.GetReservaSummaryAsync();
            if (resumoRes.IsSuccess)
            {
                Resumo = resumoRes.Data;
            }

            await Filtrar();
        }
        finally
        {
            Carregando = false;
        }
    }

    private async Task Filtrar()
    {
        var res = await OperationsApi.GetReservasAsync(
            condoId: 1,
            areaComumId: FiltroAreaId,
            status: FiltroStatus,
            dataInicio: FiltroData?.Date,
            dataFim: FiltroData?.Date.AddDays(1).AddTicks(-1));

        if (res.IsSuccess && res.Data != null)
        {
            Reservas = res.Data.ToList();
        }
    }

    private async Task LimparFiltros()
    {
        FiltroAreaId = null;
        FiltroStatus = null;
        FiltroData = null;
        await Filtrar();
    }

    private void AbrirModalNovaReserva()
    {
        ErroFormulario = string.Empty;
        FormAreaComumId = AreasComuns.FirstOrDefault()?.Id ?? 0;
        AoSelecionarArea();
        ExibirModalNovaReserva = true;
    }

    private void FecharModalNovaReserva()
    {
        ExibirModalNovaReserva = false;
    }

    private void AoSelecionarArea()
    {
        AreaSelecionada = AreasComuns.FirstOrDefault(x => x.Id == FormAreaComumId);
        if (AreaSelecionada != null)
        {
            FormQtdPessoas = Math.Min(20, AreaSelecionada.CapacidadeMaxima);
        }
    }

    private async Task SalvarReserva()
    {
        if (FormAreaComumId <= 0)
        {
            ErroFormulario = "Selecione uma área comum válida.";
            return;
        }

        if (string.IsNullOrWhiteSpace(FormNomeMorador) || string.IsNullOrWhiteSpace(FormUnidadeMorador))
        {
            ErroFormulario = "Informe o nome e unidade do morador.";
            return;
        }

        if (FormHoraInicio >= FormHoraFim)
        {
            ErroFormulario = "O horário inicial deve ser anterior ao horário final.";
            return;
        }

        ProcessandoFormulario = true;
        ErroFormulario = string.Empty;

        try
        {
            var dataInicio = FormDataReserva.Date.Add(FormHoraInicio.ToTimeSpan());
            var dataFim = FormDataReserva.Date.Add(FormHoraFim.ToTimeSpan());

            var req = new CreateReservaRequest(
                CondoId: 1,
                AreaComumId: FormAreaComumId,
                MoradorId: 10, // Mock id
                NomeMorador: FormNomeMorador,
                UnidadeMorador: FormUnidadeMorador,
                DataInicio: dataInicio,
                DataFim: dataFim,
                QuantidadePessoas: FormQtdPessoas,
                Observacao: FormObservacao);

            var res = await OperationsApi.CreateReservaAsync(req);
            if (res.IsSuccess)
            {
                ExibirModalNovaReserva = false;
                await RecarregarDados();
            }
            else
            {
                ErroFormulario = res.Message;
            }
        }
        finally
        {
            ProcessandoFormulario = false;
        }
    }

    private async Task Aprovar(int id)
    {
        var res = await OperationsApi.AprovarReservaAsync(id);
        if (res.IsSuccess)
        {
            await RecarregarDados();
        }
    }

    private void AbrirModalCancelar(ReservaDto reserva)
    {
        ReservaParaCancelar = reserva;
        MotivoCancelamento = string.Empty;
    }

    private void FecharModalCancelar()
    {
        ReservaParaCancelar = null;
    }

    private async Task ConfirmarCancelamento()
    {
        if (ReservaParaCancelar == null) return;

        var res = await OperationsApi.CancelarReservaAsync(ReservaParaCancelar.Id, MotivoCancelamento);
        if (res.IsSuccess)
        {
            ReservaParaCancelar = null;
            await RecarregarDados();
        }
    }

    private static string GetBadgeClass(StatusReserva status) => status switch
    {
        StatusReserva.Confirmada => "res-badge-confirmada",
        StatusReserva.PendenteAprovacao => "res-badge-pendente",
        StatusReserva.Cancelada => "res-badge-cancelada",
        StatusReserva.Rejeitada => "res-badge-rejeitada",
        _ => "badge bg-secondary"
    };

    private static string GetStatusText(StatusReserva status) => status switch
    {
        StatusReserva.Confirmada => "Confirmada",
        StatusReserva.PendenteAprovacao => "Pendente de Aprovação",
        StatusReserva.Cancelada => "Cancelada",
        StatusReserva.Rejeitada => "Rejeitada",
        _ => status.ToString()
    };
}
