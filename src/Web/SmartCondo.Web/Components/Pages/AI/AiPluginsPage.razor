@page "/ai/plugins"
@using Modules.Financial.Application.DTOs
@using Modules.Operations.Application.DTOs
@using Modules.AIEngine.Endpoints
@using SmartCondo.Web.Services
@inject AiApiClient AiClient
@inject IJSRuntime JS

<PageTitle>Plugins & Function Calling - SmartCondo AI</PageTitle>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Plugins & Function Calling (Semantic Kernel)</h3>
            <p class="text-muted mb-0">Execução de ferramentas fortemente tipadas e integrações de domínio via linguagem natural.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary rounded-3 fw-semibold d-flex align-items-center gap-2" @onclick="SimularComMoradorPadrao">
                <span class="material-symbols-outlined fs-5">play_arrow</span>
                <span>Simular Morador #10</span>
            </button>
        </div>
    </div>

    <!-- Navegação de Abas -->
    <AINavTabs />

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Plugins Registrados</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">2 (Boleto & Reserva)</h4>
                    </div>
                    <div class="rounded-3 p-3 bg-primary-subtle text-primary">
                        <span class="material-symbols-outlined fs-3">extension</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Tools em Produção</span>
                        <h6 class="fw-bold text-success mb-0 mt-1">GetPendingBoletos / ReserveCommonArea</h6>
                    </div>
                    <div class="rounded-3 p-3 bg-success-subtle text-success">
                        <span class="material-symbols-outlined fs-3">function</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Recursos Inclusos</span>
                        <h6 class="fw-bold text-dark mb-0 mt-1">PIX + PDF + Reserva Online</h6>
                    </div>
                    <div class="rounded-3 p-3 bg-info-subtle text-info">
                        <span class="material-symbols-outlined fs-3">event_available</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Isolamento Multi-tenant</span>
                        <h4 class="fw-bold text-primary mb-0 mt-1">Ativo (`tenant_id`)</h4>
                    </div>
                    <div class="rounded-3 p-3 bg-warning-subtle text-warning">
                        <span class="material-symbols-outlined fs-3">shield</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navegação entre Tools -->
    <div class="d-flex gap-2 mb-4">
        <button class="btn @(ActiveTab == "boleto" ? "btn-primary" : "btn-light") rounded-pill px-4 fw-semibold d-flex align-items-center gap-2"
                @onclick='() => SetActiveTab("boleto")'>
            <span class="material-symbols-outlined fs-5">receipt_long</span>
            <span>Tool 1: GetPendingBoletos (Financeiro)</span>
        </button>
        <button class="btn @(ActiveTab == "reserva" ? "btn-primary" : "btn-light") rounded-pill px-4 fw-semibold d-flex align-items-center gap-2"
                @onclick='() => SetActiveTab("reserva")'>
            <span class="material-symbols-outlined fs-5">event_available</span>
            <span>Tool 2: ReserveCommonArea (Operações & Áreas)</span>
        </button>
    </div>

    @if (ActiveTab == "boleto")
    {
        <!-- Seção de Teste de Function Calling (Boleto) -->
        <div class="row g-4">
            <!-- Coluna de Entrada & Execução -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-primary fs-4">terminal</span>
                        <h5 class="fw-bold text-dark mb-0">Simulador Function Calling: Boletos</h5>
                    </div>
                    <p class="text-muted small">
                        Informe o ID do morador para acionar a tool <code>GetPendingBoletos(moradorId)</code> registrada no Semantic Kernel.
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">ID do Morador (moradorId)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">#</span>
                            <input type="number" class="form-control bg-light border-start-0" @bind="SelectedMoradorId" placeholder="Ex: 10" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Prompt Simulação de Morador</label>
                        <textarea class="form-control bg-light" rows="3" readonly>
"Pode me enviar a segunda via do boleto e a chave PIX para pagamento da fatura pendente?"
                        </textarea>
                    </div>

                    <div class="d-flex gap-2 mt-auto pt-3">
                        <button class="btn btn-primary w-100 py-2 rounded-3 fw-semibold d-flex align-items-center justify-content-center gap-2"
                                @onclick="ExecutarPluginBoleto" disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Executando Tool...</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined fs-5">play_arrow</span>
                                <span>Executar GetPendingBoletos</span>
                            }
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger rounded-3 mt-3 mb-0 small" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ErrorMessage
                        </div>
                    }
                </div>
            </div>

            <!-- Coluna de Resultado -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-success fs-4">smart_toy</span>
                            <h5 class="fw-bold text-dark mb-0">Resposta Gerada pelo Agente</h5>
                        </div>
                        @if (ExecutionResultBoleto != null)
                        {
                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">
                                @(ExecutionResultBoleto.QuantidadePendencias > 0 ? $"{ExecutionResultBoleto.QuantidadePendencias} Débito(s) Encontrado(s)" : "Morador Adimplente")
                            </span>
                        }
                    </div>

                    @if (ExecutionResultBoleto == null)
                    {
                        <div class="text-center py-5 my-auto">
                            <span class="material-symbols-outlined text-muted fs-1 mb-2">extension_off</span>
                            <p class="text-muted mb-0">Nenhuma execução realizada. Clique no botão de execução para simular.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Resposta em Linguagem Natural -->
                        <div class="p-3 bg-light rounded-4 border mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-primary text-white rounded-pill px-2 py-1 small">Agente de IA</span>
                                <small class="text-muted">Function Choice: Auto</small>
                            </div>
                            <p class="text-dark mb-0 style-ai-response" style="white-space: pre-line;">@ExecutionResultBoleto.MensagemFormatadaFormatadaIa</p>
                        </div>

                        <!-- Lista de Boletos Retornados -->
                        @if (ExecutionResultBoleto.Boletos != null && ExecutionResultBoleto.Boletos.Any())
                        {
                            <h6 class="fw-bold text-dark mb-3">Detalhes do(s) Boleto(s) Retornado(s)</h6>
                            <div class="d-flex flex-column gap-3">
                                @foreach (var boleto in ExecutionResultBoleto.Boletos)
                                {
                                    <div class="card border border-light-subtle rounded-3 p-3 shadow-none bg-body-tertiary">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="fw-bold text-dark">@boleto.NumeroFatura</span>
                                                <span class="badge bg-secondary-subtle text-secondary">Comp: @boleto.Competencia</span>
                                                @if (boleto.Vencido)
                                                {
                                                    <span class="badge bg-danger text-white">Vencido</span>
                                                }
                                            </div>
                                            <h5 class="fw-bold text-primary mb-0">R$ @boleto.ValorTotal.ToString("F2")</h5>
                                        </div>

                                        <div class="row g-2 mb-3 small text-muted">
                                            <div class="col-md-6">
                                                <strong>Vencimento:</strong> @boleto.DataVencimento.ToString("dd/MM/yyyy")
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Linha Digitável:</strong> <code>@boleto.LinhaDigitavel</code>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(boleto.CodigoPixCopiaECola))
                                        {
                                            <div class="mb-2">
                                                <label class="form-label small fw-semibold text-dark mb-1">Chave PIX Copia e Cola:</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bg-white font-monospace small" value="@boleto.CodigoPixCopiaECola" readonly />
                                                    <button class="btn btn-outline-primary" @onclick="() => CopiarPix(boleto.CodigoPixCopiaECola)">
                                                        <span class="material-symbols-outlined fs-6 align-middle">content_copy</span> Copiar PIX
                                                    </button>
                                                </div>
                                            </div>
                                        }

                                        <div class="d-flex justify-content-end mt-2">
                                            <a href="@boleto.PdfUrl" target="_blank" class="btn btn-sm btn-outline-dark rounded-2 d-flex align-items-center gap-1">
                                                <span class="material-symbols-outlined fs-6">picture_as_pdf</span>
                                                <span>Visualizar PDF</span>
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Seção de Teste de Function Calling (Reserva de Área Comum) -->
        <div class="row g-4">
            <!-- Coluna de Entrada & Formulário -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-primary fs-4">event_available</span>
                        <h5 class="fw-bold text-dark mb-0">Simulador Function Calling: Reservas</h5>
                    </div>
                    <p class="text-muted small">
                        Selecione a área e informe os dados para acionar a tool <code>ReserveCommonArea(areaId, dataInicio, dataFim, moradorId, quantidadePessoas)</code>.
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Área Comum</label>
                        <select class="form-select bg-light" @bind="ReservaAreaId">
                            @if (ActiveAreas == null || !ActiveAreas.Any())
                            {
                                <option value="1">Salão de Festas Principal (ID #1)</option>
                                <option value="2">Churrasqueira Gourmet (ID #2)</option>
                            }
                            else
                            {
                                @foreach (var area in ActiveAreas)
                                {
                                    <option value="@area.Id">@area.Nome (Capacidade: @area.CapacidadeMaxima) - ID #@area.Id</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold text-dark small">ID Morador</label>
                            <input type="number" class="form-control bg-light" @bind="ReservaMoradorId" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold text-dark small">Qtd Pessoas</label>
                            <input type="number" class="form-control bg-light" @bind="ReservaQtdPessoas" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold text-dark small">Data/Hora Início</label>
                            <input type="text" class="form-control bg-light" @bind="ReservaDataInicio" placeholder="yyyy-MM-dd HH:mm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold text-dark small">Data/Hora Término</label>
                            <input type="text" class="form-control bg-light" @bind="ReservaDataFim" placeholder="yyyy-MM-dd HH:mm" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small">Observações do Agendamento</label>
                        <input type="text" class="form-control bg-light" @bind="ReservaObservacao" placeholder="Ex: Aniversário da família" />
                    </div>

                    <div class="d-flex gap-2 mt-auto pt-3">
                        <button class="btn btn-primary w-100 py-2 rounded-3 fw-semibold d-flex align-items-center justify-content-center gap-2"
                                @onclick="ExecutarPluginReserva" disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Agendando Área...</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined fs-5">play_arrow</span>
                                <span>Executar ReserveCommonArea</span>
                            }
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger rounded-3 mt-3 mb-0 small" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ErrorMessage
                        </div>
                    }
                </div>
            </div>

            <!-- Coluna de Resultado -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-success fs-4">confirmation_number</span>
                            <h5 class="fw-bold text-dark mb-0">Comprovante & Resposta da IA</h5>
                        </div>
                        @if (ExecutionResultReserva != null)
                        {
                            <span class="badge @(ExecutionResultReserva.Sucesso ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-3 py-2 rounded-pill fw-semibold">
                                @(ExecutionResultReserva.Sucesso ? $"Reserva #{ExecutionResultReserva.ReservaId} ({ExecutionResultReserva.Status})" : "Agendamento Recusado")
                            </span>
                        }
                    </div>

                    @if (ExecutionResultReserva == null)
                    {
                        <div class="text-center py-5 my-auto">
                            <span class="material-symbols-outlined text-muted fs-1 mb-2">event_busy</span>
                            <p class="text-muted mb-0">Nenhum agendamento executado. Clique no botão de execução para simular a chamada da tool.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Resposta em Linguagem Natural -->
                        <div class="p-3 bg-light rounded-4 border mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-primary text-white rounded-pill px-2 py-1 small">Agente de IA</span>
                                <small class="text-muted">Tool: ReserveCommonArea</small>
                            </div>
                            <p class="text-dark mb-0 style-ai-response">@ExecutionResultReserva.MensagemFormatadaIa</p>
                        </div>

                        <!-- Card de Confirmação da Reserva (Stitch Design) -->
                        <div class="card border border-primary-subtle rounded-4 p-4 bg-primary-subtle text-dark shadow-sm">
                            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom border-primary-subtle pb-3">
                                <div>
                                    <span class="text-muted small fw-medium">Comprovante de Solicitacao</span>
                                    <h4 class="fw-bold text-primary mb-0">@ExecutionResultReserva.NomeAreaComum</h4>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-primary text-white px-3 py-2 rounded-pill">Status: @ExecutionResultReserva.Status</span>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <span class="text-muted small d-block">Morador / Solicitante</span>
                                    <strong class="text-dark">Morador #@ExecutionResultReserva.MoradorId</strong>
                                </div>
                                <div class="col-md-6">
                                    <span class="text-muted small d-block">Qtd Convidados</span>
                                    <strong class="text-dark">@ExecutionResultReserva.QuantidadePessoas Pessoa(s)</strong>
                                </div>
                                <div class="col-md-6">
                                    <span class="text-muted small d-block">Data / Hora Inicio</span>
                                    <strong class="text-dark">@ExecutionResultReserva.DataInicio</strong>
                                </div>
                                <div class="col-md-6">
                                    <span class="text-muted small d-block">Data / Hora Termino</span>
                                    <strong class="text-dark">@ExecutionResultReserva.DataFim</strong>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between pt-3 border-top border-primary-subtle">
                                <span class="fw-semibold text-muted">Valor Total Calculado:</span>
                                <h3 class="fw-bold text-success mb-0">R$ @ExecutionResultReserva.ValorTotal.ToString("F2")</h3>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string ActiveTab = "boleto";
    private int SelectedMoradorId = 10;

    // Campos Simulador de Reserva
    private int ReservaAreaId = 1;
    private int ReservaMoradorId = 10;
    private int ReservaQtdPessoas = 20;
    private string ReservaDataInicio = DateTime.UtcNow.AddDays(3).Date.AddHours(18).ToString("yyyy-MM-dd HH:mm");
    private string ReservaDataFim = DateTime.UtcNow.AddDays(3).Date.AddHours(22).ToString("yyyy-MM-dd HH:mm");
    private string ReservaObservacao = "Festa de Aniversário Familiar";

    private bool IsLoading = false;
    private string? ErrorMessage;
    private BoletoPluginExecutionResultDto? ExecutionResultBoleto;
    private ReservaPluginExecutionResultDto? ExecutionResultReserva;
    private IEnumerable<AreaComumDto>? ActiveAreas;

    protected override async Task OnInitializedAsync()
    {
        await LoadActiveAreas();
    }

    private void SetActiveTab(string tab)
    {
        ActiveTab = tab;
        ErrorMessage = null;
    }

    private async Task LoadActiveAreas()
    {
        try
        {
            var res = await AiClient.GetActiveAreasComunsAsync();
            if (res != null && res.IsSuccess && res.Data != null)
            {
                ActiveAreas = res.Data;
                if (ActiveAreas.Any())
                {
                    ReservaAreaId = ActiveAreas.First().Id;
                }
            }
        }
        catch
        {
            // Fallback gracioso se a API não retornar áreas
        }
    }

    private async Task SimularComMoradorPadrao()
    {
        SelectedMoradorId = 10;
        ReservaMoradorId = 10;
        if (ActiveTab == "boleto")
        {
            await ExecutarPluginBoleto();
        }
        else
        {
            await ExecutarPluginReserva();
        }
    }

    private async Task ExecutarPluginBoleto()
    {
        ErrorMessage = null;

        if (SelectedMoradorId <= 0)
        {
            ErrorMessage = "Informe um ID de morador válido (maior que zero).";
            return;
        }

        IsLoading = true;

        try
        {
            var result = await AiClient.ExecuteBoletoPluginAsync(SelectedMoradorId);
            if (result != null && result.IsSuccess && result.Data != null)
            {
                ExecutionResultBoleto = result.Data;
            }
            else
            {
                ErrorMessage = result?.Message ?? "Não foi possível executar o plugin de boleto.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Exceção ao invocar a API: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ExecutarPluginReserva()
    {
        ErrorMessage = null;

        if (ReservaAreaId <= 0 || ReservaMoradorId <= 0)
        {
            ErrorMessage = "Informe a área comum e o ID do morador válidos.";
            return;
        }

        IsLoading = true;

        try
        {
            var req = new ExecuteReservaPluginRequest(
                AreaId: ReservaAreaId,
                DataInicio: ReservaDataInicio,
                DataFim: ReservaDataFim,
                MoradorId: ReservaMoradorId,
                QuantidadePessoas: ReservaQtdPessoas,
                Observacao: ReservaObservacao);

            var result = await AiClient.ExecuteReservaPluginAsync(req);
            if (result != null && result.IsSuccess && result.Data != null)
            {
                ExecutionResultReserva = result.Data;
            }
            else
            {
                ErrorMessage = result?.Message ?? "Não foi possível executar o agendamento da área comum.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Exceção ao invocar a API de reservas: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CopiarPix(string codigoPix)
    {
        if (!string.IsNullOrEmpty(codigoPix))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", codigoPix);
        }
    }
}
