@page "/ai/plugins"
@using Modules.Financial.Application.DTOs
@using Modules.Operations.Application.DTOs
@using Modules.AIEngine.Endpoints
@using SmartCondo.Web.Services
@inject AiApiClient AiClient
@inject IJSRuntime JS

<PageTitle>Plugins & Function Calling - SmartCondo AI</PageTitle>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Plugins & Function Calling (Semantic Kernel)</h3>
            <p class="text-muted mb-0">Execução de ferramentas fortemente tipadas e integrações de domínio via linguagem natural.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary rounded-3 fw-semibold d-flex align-items-center gap-2" @onclick="SimularComMoradorPadrao">
                <span class="material-symbols-outlined fs-5">play_arrow</span>
                <span>Simular Morador #10</span>
            </button>
        </div>
    </div>

    <!-- Navegação de Abas -->
    <AINavTabs />

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Plugins Registrados</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">4 (Boleto, Reserva, Portaria & Vision OCR)</h4>
                    </div>
                    <div class="rounded-3 p-3 bg-primary-subtle text-primary">
                        <span class="material-symbols-outlined fs-3">extension</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Tools em Produção</span>
                        <h6 class="fw-bold text-success mb-0 mt-1">Boleto / Reserva / Portaria / Vision OCR</h6>
                    </div>
                    <div class="rounded-3 p-3 bg-success-subtle text-success">
                        <span class="material-symbols-outlined fs-3">function</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Recursos Inclusos</span>
                        <h6 class="fw-bold text-dark mb-0 mt-1">PIX + PDF + Reserva + OCR Etiquetas</h6>
                    </div>
                    <div class="rounded-3 p-3 bg-info-subtle text-info">
                        <span class="material-symbols-outlined fs-3">event_available</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Isolamento Multi-tenant</span>
                        <h4 class="fw-bold text-primary mb-0 mt-1">Ativo (`tenant_id`)</h4>
                    </div>
                    <div class="rounded-3 p-3 bg-warning-subtle text-warning">
                        <span class="material-symbols-outlined fs-3">shield</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navegação entre Tools -->
    <div class="d-flex gap-2 mb-4 flex-wrap">
        <button class="btn @(ActiveTab == "boleto" ? "btn-primary" : "btn-light") rounded-pill px-4 fw-semibold d-flex align-items-center gap-2"
                @onclick='() => SetActiveTab("boleto")'>
            <span class="material-symbols-outlined fs-5">receipt_long</span>
            <span>Tool 1: GetPendingBoletos (Financeiro)</span>
        </button>
        <button class="btn @(ActiveTab == "reserva" ? "btn-primary" : "btn-light") rounded-pill px-4 fw-semibold d-flex align-items-center gap-2"
                @onclick='() => SetActiveTab("reserva")'>
            <span class="material-symbols-outlined fs-5">event_available</span>
            <span>Tool 2: ReserveCommonArea (Operações & Áreas)</span>
        </button>
        <button class="btn @(ActiveTab == "portaria" ? "btn-primary" : "btn-light") rounded-pill px-4 fw-semibold d-flex align-items-center gap-2"
                @onclick='() => SetActiveTab("portaria")'>
            <span class="material-symbols-outlined fs-5">badge</span>
            <span>Tool 3: AuthorizeGuest (Portaria & Visitantes)</span>
        </button>
        <button class="btn @(ActiveTab == "package_vision" ? "btn-primary" : "btn-light") rounded-pill px-4 fw-semibold d-flex align-items-center gap-2"
                @onclick='() => SetActiveTab("package_vision")'>
            <span class="material-symbols-outlined fs-5">center_focus_strong</span>
            <span>Tool 4: ReadPackageLabel (Visão/OCR & Encomendas)</span>
        </button>
    </div>

    @if (ActiveTab == "boleto")
    {
        <!-- Seção de Teste de Function Calling (Boleto) -->
        <div class="row g-4">
            <!-- Coluna de Entrada & Execução -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-primary fs-4">terminal</span>
                        <h5 class="fw-bold text-dark mb-0">Simular Função Boleto</h5>
                    </div>
                    <p class="text-muted small">Invoca a ferramenta de consulta de faturas em aberto e geração de PIX/PDF para o morador informado.</p>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold small">ID do Morador (moradorId)</label>
                        <input type="number" class="form-control rounded-3" @bind="SelectedMoradorId" min="1" placeholder="Ex: 10" />
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-4">
                        <span class="text-muted small d-block mb-1 fw-medium">Comando equivalente em Linguagem Natural:</span>
                        <code class="text-dark small">"Pode me mandar o boleto deste mês para o morador #@SelectedMoradorId?"</code>
                    </div>

                    <button class="btn btn-primary rounded-3 w-100 fw-semibold d-flex align-items-center justify-content-center gap-2 py-2"
                            @onclick="ExecutarPluginBoleto" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Consultando Boleto...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined fs-5">play_arrow</span>
                            <span>Executar Function Calling (Boleto)</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger rounded-3 mt-3 mb-0 small">
                            <span class="material-symbols-outlined align-middle fs-5 me-1">error</span>
                            @ErrorMessage
                        </div>
                    }
                </div>
            </div>

            <!-- Coluna de Resposta & Comprovante -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-success fs-4">forum</span>
                            <h5 class="fw-bold text-dark mb-0">Resposta Gerada pelo Agente (IA)</h5>
                        </div>
                        @if (ExecutionResultBoleto != null)
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 fw-semibold">Sucesso</span>
                        }
                    </div>

                    @if (ExecutionResultBoleto == null)
                    {
                        <div class="text-center py-5 my-auto text-muted">
                            <span class="material-symbols-outlined fs-1 text-secondary opacity-50 mb-2">find_in_page</span>
                            <p class="mb-0">Clique em "Executar Function Calling" para visualizar o retorno da ferramenta do Semantic Kernel.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Mensagem do Agente em Balão -->
                        <div class="p-3 rounded-4 mb-4" style="background-color: #F4EAE1; border-left: 4px solid #2E5B88;">
                            <span class="text-muted extra-small d-block mb-1 fw-bold text-uppercase">Resposta do Agente:</span>
                            <p class="mb-0 text-dark fw-medium" style="white-space: pre-line;">@ExecutionResultBoleto.MensagemFormatadaFormatadaIa</p>
                        </div>

                        <!-- Card Detalhado do Boleto/PIX -->
                        @if (ExecutionResultBoleto.Boletos != null && ExecutionResultBoleto.Boletos.Any())
                        {
                            var primeiroBoleto = ExecutionResultBoleto.Boletos.First();
                            <div class="card border border-light-subtle rounded-4 p-3 bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-primary text-white rounded-2 px-2 py-1">Fatura #@primeiroBoleto.FaturaId</span>
                                    <span class="fw-bold text-danger fs-5">R$ @primeiroBoleto.ValorTotal.ToString("F2")</span>
                                </div>
                                <p class="text-muted small mb-2">Vencimento: <strong>@primeiroBoleto.DataVencimento.ToString("dd/MM/yyyy")</strong></p>

                                <div class="mb-3">
                                    <label class="form-label extra-small text-muted mb-1">Chave PIX Copia e Cola:</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control form-control-sm font-monospace bg-white" value="@primeiroBoleto.CodigoPixCopiaECola" readonly />
                                        <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" @onclick="() => CopiarPix(primeiroBoleto.CodigoPixCopiaECola)">
                                            <span class="material-symbols-outlined fs-6">content_copy</span>
                                            <span>Copiar</span>
                                        </button>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end">
                                    <a href="@primeiroBoleto.PdfUrl" target="_blank" class="btn btn-outline-primary btn-sm rounded-3 d-flex align-items-center gap-1">
                                        <span class="material-symbols-outlined fs-6">picture_as_pdf</span>
                                        <span>Baixar PDF</span>
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info rounded-3 mb-0 small">
                                <span class="material-symbols-outlined align-middle fs-5 me-1">check_circle</span>
                                Nenhuma fatura pendente encontrada para este morador.
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
    else if (ActiveTab == "reserva")
    {
        <!-- Seção de Teste de Function Calling (Reserva de Áreas Comuns) -->
        <div class="row g-4">
            <!-- Coluna de Formulário de Entrada -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-primary fs-4">event_available</span>
                        <h5 class="fw-bold text-dark mb-0">Simular Agendamento de Área</h5>
                    </div>
                    <p class="text-muted small">Invoca a ferramenta de checagem de colisão e agendamento de áreas comuns (`ReserveCommonArea`).</p>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold small">Área Comum</label>
                        @if (ActiveAreas != null && ActiveAreas.Any())
                        {
                            <select class="form-select rounded-3" @bind="ReservaAreaId">
                                @foreach (var area in ActiveAreas)
                                {
                                    <option value="@area.Id">@area.Nome (Capacidade: @area.CapacidadeMaxima | R$ @area.CustoTotalReserva.ToString("F2"))</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="number" class="form-control rounded-3" @bind="ReservaAreaId" min="1" placeholder="ID da Área (ex: 1)" />
                        }
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-dark fw-semibold small">ID Morador</label>
                            <input type="number" class="form-control rounded-3" @bind="ReservaMoradorId" min="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-dark fw-semibold small">Convidados</label>
                            <input type="number" class="form-control rounded-3" @bind="ReservaQtdPessoas" min="1" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold small">Data/Hora Início</label>
                        <input type="text" class="form-control rounded-3" @bind="ReservaDataInicio" placeholder="yyyy-MM-dd HH:mm" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold small">Data/Hora Término</label>
                        <input type="text" class="form-control rounded-3" @bind="ReservaDataFim" placeholder="yyyy-MM-dd HH:mm" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-dark fw-semibold small">Observação do Evento</label>
                        <input type="text" class="form-control rounded-3" @bind="ReservaObservacao" placeholder="Ex: Aniversário da família" />
                    </div>

                    <button class="btn btn-primary rounded-3 w-100 fw-semibold d-flex align-items-center justify-content-center gap-2 py-2"
                            @onclick="ExecutarPluginReserva" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Reservando Área...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined fs-5">play_arrow</span>
                            <span>Executar Function Calling (ReserveCommonArea)</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger rounded-3 mt-3 mb-0 small">
                            <span class="material-symbols-outlined align-middle fs-5 me-1">error</span>
                            @ErrorMessage
                        </div>
                    }
                </div>
            </div>

            <!-- Coluna de Resposta & Comprovante de Reserva -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-success fs-4">forum</span>
                            <h5 class="fw-bold text-dark mb-0">Resposta Gerada pelo Agente (IA)</h5>
                        </div>
                        @if (ExecutionResultReserva != null)
                        {
                            <span class="badge @(ExecutionResultReserva.Sucesso ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-pill px-3 py-2 fw-semibold">
                                @(ExecutionResultReserva.Sucesso ? "Reserva Efetuada" : "Erro / Conflito")
                            </span>
                        }
                    </div>

                    @if (ExecutionResultReserva == null)
                    {
                        <div class="text-center py-5 my-auto text-muted">
                            <span class="material-symbols-outlined fs-1 text-secondary opacity-50 mb-2">event_seat</span>
                            <p class="mb-0">Preencha os dados e clique em "Executar Function Calling" para simular a reserva de área comum via assistente virtual.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Mensagem do Agente em Balão -->
                        <div class="p-3 rounded-4 mb-4" style="background-color: #F4EAE1; border-left: 4px solid #2E5B88;">
                            <span class="text-muted extra-small d-block mb-1 fw-bold text-uppercase">Resposta do Agente:</span>
                            <p class="mb-0 text-dark fw-medium" style="white-space: pre-line;">@ExecutionResultReserva.MensagemFormatadaIa</p>
                        </div>

                        <!-- Card Detalhado do Comprovante de Reserva -->
                        <div class="card border border-light-subtle rounded-4 p-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="badge bg-primary text-white rounded-2 px-2 py-1 mb-1">Reserva #@(ExecutionResultReserva.ReservaId?.ToString() ?? "N/A")</span>
                                    <h5 class="fw-bold text-dark mb-0">@ExecutionResultReserva.NomeAreaComum</h5>
                                </div>
                                <span class="badge bg-info-subtle text-info px-3 py-2 rounded-pill fw-semibold">@ExecutionResultReserva.Status</span>
                            </div>

                            <div class="row g-2 text-muted small mb-3">
                                <div class="col-6">
                                    <span>Início: <strong>@ExecutionResultReserva.DataInicio</strong></span>
                                </div>
                                <div class="col-6">
                                    <span>Término: <strong>@ExecutionResultReserva.DataFim</strong></span>
                                </div>
                                <div class="col-6">
                                    <span>Solicitante: <strong>Morador #@ExecutionResultReserva.MoradorId</strong></span>
                                </div>
                                <div class="col-6">
                                    <span>Convidados: <strong>@ExecutionResultReserva.QuantidadePessoas pessoa(s)</strong></span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="text-muted small fw-medium">Valor Total da Taxa:</span>
                                <h3 class="fw-bold text-success mb-0">R$ @ExecutionResultReserva.ValorTotal.ToString("F2")</h3>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (ActiveTab == "portaria")
    {
        <!-- Seção de Teste de Function Calling (Portaria & Liberação de Visitantes) -->
        <div class="row g-4">
            <!-- Coluna de Formulário de Entrada -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-primary fs-4">badge</span>
                        <h5 class="fw-bold text-dark mb-0">Simular Liberação na Portaria</h5>
                    </div>
                    <p class="text-muted small">Invoca a ferramenta de pré-autorização de visitante ou prestador (`AuthorizeGuest`).</p>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold small">Nome Completo</label>
                        <input type="text" class="form-control rounded-3" @bind="PortariaNome" placeholder="Ex: Carlos Eduardo" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-dark fw-semibold small">CPF / RG</label>
                            <input type="text" class="form-control rounded-3" @bind="PortariaDocumento" placeholder="Ex: 123.456.789-00" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-dark fw-semibold small">Tipo de Entrada</label>
                            <select class="form-select rounded-3" @bind="PortariaTipo">
                                <option value="Visitante">Visitante</option>
                                <option value="PrestadorServico">Prestador de Serviço</option>
                            </select>
                        </div>
                    </div>

                    @if (PortariaTipo == "PrestadorServico")
                    {
                        <div class="mb-3">
                            <label class="form-label text-dark fw-semibold small">Empresa / Razão Social <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-3" @bind="PortariaEmpresa" placeholder="Ex: Manutenção Tech Ltda" />
                        </div>
                    }

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-dark fw-semibold small">ID Unidade</label>
                            <input type="number" class="form-control rounded-3" @bind="PortariaUnidadeId" min="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-dark fw-semibold small">Bloco / Apto</label>
                            <input type="text" class="form-control rounded-3" @bind="PortariaBlocoUnidade" placeholder="Ex: Bloco A - 102" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-dark fw-semibold small">Validade Início</label>
                            <input type="text" class="form-control rounded-3" @bind="PortariaValidadeInicio" placeholder="yyyy-MM-dd HH:mm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-dark fw-semibold small">Validade Fim</label>
                            <input type="text" class="form-control rounded-3" @bind="PortariaValidadeFim" placeholder="yyyy-MM-dd HH:mm" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-dark fw-semibold small">Placa do Veículo</label>
                            <input type="text" class="form-control rounded-3" @bind="PortariaPlacaVeiculo" placeholder="Ex: ABC-1234" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-dark fw-semibold small">Telefone</label>
                            <input type="text" class="form-control rounded-3" @bind="PortariaTelefone" placeholder="+5575999998888" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-dark fw-semibold small">Observações Portaria</label>
                        <input type="text" class="form-control rounded-3" @bind="PortariaObservacoes" placeholder="Ex: Convidado para jantar" />
                    </div>

                    <button class="btn btn-primary rounded-3 w-100 fw-semibold d-flex align-items-center justify-content-center gap-2 py-2"
                            @onclick="ExecutarPluginPortaria" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Cadastrando Autorização...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined fs-5">play_arrow</span>
                            <span>Executar Function Calling (AuthorizeGuest)</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger rounded-3 mt-3 mb-0 small">
                            <span class="material-symbols-outlined align-middle fs-5 me-1">error</span>
                            @ErrorMessage
                        </div>
                    }
                </div>
            </div>

            <!-- Coluna de Resposta & Comprovante de Autorização na Portaria -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-success fs-4">forum</span>
                            <h5 class="fw-bold text-dark mb-0">Resposta Gerada pelo Agente (IA)</h5>
                        </div>
                        @if (ExecutionResultPortaria != null)
                        {
                            <span class="badge @(ExecutionResultPortaria.Sucesso ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-pill px-3 py-2 fw-semibold">
                                @(ExecutionResultPortaria.Sucesso ? "Autorização Registrada" : "Erro")
                            </span>
                        }
                    </div>

                    @if (ExecutionResultPortaria == null)
                    {
                        <div class="text-center py-5 my-auto text-muted">
                            <span class="material-symbols-outlined fs-1 text-secondary opacity-50 mb-2">badge</span>
                            <p class="mb-0">Preencha os dados e clique em "Executar Function Calling" para simular a liberação de acesso na portaria via assistente virtual.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Mensagem do Agente em Balão -->
                        <div class="p-3 rounded-4 mb-4" style="background-color: #F4EAE1; border-left: 4px solid #2E5B88;">
                            <span class="text-muted extra-small d-block mb-1 fw-bold text-uppercase">Resposta do Agente:</span>
                            <p class="mb-0 text-dark fw-medium" style="white-space: pre-line;">@ExecutionResultPortaria.MensagemFormatadaIa</p>
                        </div>

                        <!-- Card Detalhado do Comprovante de Liberação na Portaria -->
                        <div class="card border border-light-subtle rounded-4 p-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="badge bg-primary text-white rounded-2 px-2 py-1 mb-1">Autorização #@(ExecutionResultPortaria.AutorizacaoId?.ToString() ?? "N/A")</span>
                                    <h5 class="fw-bold text-dark mb-0">@ExecutionResultPortaria.NomeCompleto</h5>
                                    <span class="text-muted small">CPF/RG: @ExecutionResultPortaria.Documento</span>
                                </div>
                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">@ExecutionResultPortaria.Status</span>
                            </div>

                            <div class="row g-2 text-muted small mb-3">
                                <div class="col-6">
                                    <span>Tipo: <strong>@ExecutionResultPortaria.Tipo</strong></span>
                                </div>
                                <div class="col-6">
                                    <span>Destino: <strong>@ExecutionResultPortaria.BlocoUnidade</strong></span>
                                </div>
                                <div class="col-6">
                                    <span>Validez Início: <strong>@ExecutionResultPortaria.ValidadeInicio</strong></span>
                                </div>
                                <div class="col-6">
                                    <span>Validez Término: <strong>@ExecutionResultPortaria.ValidadeFim</strong></span>
                                </div>
                                @if (!string.IsNullOrEmpty(ExecutionResultPortaria.Empresa))
                                {
                                    <div class="col-6">
                                        <span>Empresa: <strong>@ExecutionResultPortaria.Empresa</strong></span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(ExecutionResultPortaria.PlacaVeiculo))
                                {
                                    <div class="col-6">
                                        <span>Placa Veículo: <strong>@ExecutionResultPortaria.PlacaVeiculo</strong></span>
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="text-muted small fw-medium">Status de Liberação:</span>
                                <span class="badge bg-success text-white rounded-pill px-3 py-1">Pronto para Entrada na Portaria</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (ActiveTab == "package_vision")
    {
        <!-- Seção de Teste de Function Calling (Vision OCR Etiquetas) -->
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined text-primary fs-4">center_focus_strong</span>
                        <span>Parâmetros de Leitura de Etiqueta (OCR)</span>
                    </h5>
                    <p class="text-muted small">Simule a captura e análise multimodal de uma etiqueta de pacote na portaria para extração e notificação automática.</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Imagens de Exemplo para Teste</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick='() => VisionImagemEtiqueta = "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=500"'>Mercado Livre (102)</button>
                            <button class="btn btn-sm btn-outline-warning" @onclick='() => VisionImagemEtiqueta = "https://images.unsplash.com/photo-1566576721346-d4a3b4eaeb55?w=500"'>Amazon (204)</button>
                            <button class="btn btn-sm btn-outline-success" @onclick='() => VisionImagemEtiqueta = "https://images.unsplash.com/photo-1578575437130-527eed3abbec?w=500"'>Correios (301)</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Foto / URL da Etiqueta <span class="text-danger">*</span></label>
                        <input type="text" class="form-control rounded-3" @bind="VisionImagemEtiqueta" placeholder="https://exemplo.com/etiqueta.jpg ou Base64..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Operador Responsável</label>
                        <input type="text" class="form-control rounded-3" @bind="VisionRecebidoPor" placeholder="Ex: Portaria Central" />
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" id="visionCheckNotif" @bind="VisionEnviarNotificacao" />
                        <label class="form-check-label fw-semibold text-dark small" for="visionCheckNotif">
                            Notificar morador no WhatsApp imediatamente após extração
                        </label>
                    </div>

                    <button class="btn btn-primary rounded-3 w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2"
                            @onclick="ExecutarPluginPackageVision" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Executando Visão OCR...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined fs-5">scan</span>
                            <span>Executar Tool ReadPackageLabelAndNotify</span>
                        }
                    </button>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined text-success fs-4">terminal</span>
                        <span>Resultado da Execução do Agente</span>
                    </h5>

                    @if (ExecutionResultPackageVision == null && !IsLoading)
                    {
                        <div class="text-center py-5 text-muted">
                            <span class="material-symbols-outlined fs-1 text-black-50 mb-2">qr_code_scanner</span>
                            <p class="mb-0">Clique em "Executar Tool ReadPackageLabelAndNotify" para simular a extração e cadastro da encomenda.</p>
                        </div>
                    }

                    @if (ExecutionResultPackageVision != null)
                    {
                        <div class="alert alert-success border-0 rounded-4 p-3 mb-3 d-flex align-items-center gap-3" style="background: #e8f5e9;">
                            <span class="material-symbols-outlined fs-2 text-success">check_circle</span>
                            <div>
                                <h6 class="fw-bold text-success mb-1">Status: @ExecutionResultPackageVision.Status</h6>
                                <p class="small text-dark mb-0">@ExecutionResultPackageVision.MensagemFormatadaIa</p>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-3">
                                    <div class="text-muted small">Encomenda Cadastrada</div>
                                    <div class="fw-bold fs-5 text-dark">#@ExecutionResultPackageVision.EncomendaId</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-3">
                                    <div class="text-muted small">Destino Identificado</div>
                                    <div class="fw-bold fs-5 text-primary">@ExecutionResultPackageVision.BlocoUnidade</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-3">
                                    <div class="text-muted small">Código de Rastreio</div>
                                    <div class="fw-bold text-dark font-monospace">@ExecutionResultPackageVision.CodigoRastreio</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-3">
                                    <div class="text-muted small">Notificação WhatsApp</div>
                                    <div class="fw-bold text-success">@(ExecutionResultPackageVision.NotificacaoMoradorEnviada ? "Enviada ao Morador" : "Pendente")</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string ActiveTab = "boleto";
    private int SelectedMoradorId = 10;

    // Campos Simulador de Reserva
    private int ReservaAreaId = 1;
    private int ReservaMoradorId = 10;
    private int ReservaQtdPessoas = 20;
    private string ReservaDataInicio = DateTime.UtcNow.AddDays(3).Date.AddHours(18).ToString("yyyy-MM-dd HH:mm");
    private string ReservaDataFim = DateTime.UtcNow.AddDays(3).Date.AddHours(22).ToString("yyyy-MM-dd HH:mm");
    private string ReservaObservacao = "Festa de Aniversário Familiar";

    // Campos Simulador de Portaria
    private string PortariaNome = "Carlos Eduardo";
    private string PortariaDocumento = "123.456.789-00";
    private string PortariaTipo = "Visitante";
    private string? PortariaEmpresa = null;
    private int PortariaUnidadeId = 102;
    private string PortariaBlocoUnidade = "Bloco A - Apto 102";
    private string PortariaValidadeInicio = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm");
    private string PortariaValidadeFim = DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-dd HH:mm");
    private string? PortariaPlacaVeiculo = "ABC-1234";
    private string? PortariaTelefone = "+5575988887777";
    private string? PortariaObservacoes = "Convidado de jantar";

    // Campos Simulador de Vision OCR
    private string VisionImagemEtiqueta = "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=500";
    private string VisionRecebidoPor = "Portaria IA (Vision OCR)";
    private bool VisionEnviarNotificacao = true;

    private bool IsLoading = false;
    private string? ErrorMessage;
    private BoletoPluginExecutionResultDto? ExecutionResultBoleto;
    private ReservaPluginExecutionResultDto? ExecutionResultReserva;
    private AuthorizeGuestPluginExecutionResultDto? ExecutionResultPortaria;
    private PackageVisionPluginExecutionResultDto? ExecutionResultPackageVision;
    private IEnumerable<AreaComumDto>? ActiveAreas;

    protected override async Task OnInitializedAsync()
    {
        await LoadActiveAreas();
    }

    private void SetActiveTab(string tab)
    {
        ActiveTab = tab;
        ErrorMessage = null;
    }

    private async Task LoadActiveAreas()
    {
        try
        {
            var res = await AiClient.GetActiveAreasComunsAsync();
            if (res != null && res.IsSuccess && res.Data != null)
            {
                ActiveAreas = res.Data;
                if (ActiveAreas.Any())
                {
                    ReservaAreaId = ActiveAreas.First().Id;
                }
            }
        }
        catch
        {
            // Fallback gracioso se a API não retornar áreas
        }
    }

    private async Task SimularComMoradorPadrao()
    {
        SelectedMoradorId = 10;
        ReservaMoradorId = 10;
        if (ActiveTab == "boleto")
        {
            await ExecutarPluginBoleto();
        }
        else if (ActiveTab == "reserva")
        {
            await ExecutarPluginReserva();
        }
        else
        {
            await ExecutarPluginPortaria();
        }
    }

    private async Task ExecutarPluginBoleto()
    {
        ErrorMessage = null;

        if (SelectedMoradorId <= 0)
        {
            ErrorMessage = "Informe um ID de morador válido (maior que zero).";
            return;
        }

        IsLoading = true;

        try
        {
            var result = await AiClient.ExecuteBoletoPluginAsync(SelectedMoradorId);
            if (result != null && result.IsSuccess && result.Data != null)
            {
                ExecutionResultBoleto = result.Data;
            }
            else
            {
                ErrorMessage = result?.Message ?? "Não foi possível executar o plugin de boleto.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Exceção ao invocar a API: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ExecutarPluginReserva()
    {
        ErrorMessage = null;

        if (ReservaAreaId <= 0 || ReservaMoradorId <= 0)
        {
            ErrorMessage = "Informe a área comum e o ID do morador válidos.";
            return;
        }

        IsLoading = true;

        try
        {
            var req = new ExecuteReservaPluginRequest(
                AreaId: ReservaAreaId,
                DataInicio: ReservaDataInicio,
                DataFim: ReservaDataFim,
                MoradorId: ReservaMoradorId,
                QuantidadePessoas: ReservaQtdPessoas,
                Observacao: ReservaObservacao);

            var result = await AiClient.ExecuteReservaPluginAsync(req);
            if (result != null && result.IsSuccess && result.Data != null)
            {
                ExecutionResultReserva = result.Data;
            }
            else
            {
                ErrorMessage = result?.Message ?? "Não foi possível executar o agendamento da área comum.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Exceção ao invocar a API de reservas: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ExecutarPluginPortaria()
    {
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(PortariaNome) || string.IsNullOrWhiteSpace(PortariaDocumento))
        {
            ErrorMessage = "Preencha o nome completo e documento (CPF/RG) do visitante.";
            return;
        }

        if (PortariaTipo == "PrestadorServico" && string.IsNullOrWhiteSpace(PortariaEmpresa))
        {
            ErrorMessage = "Informe a empresa para prestadores de serviço.";
            return;
        }

        IsLoading = true;

        try
        {
            var req = new ExecuteAuthorizeGuestPluginRequest(
                Nome: PortariaNome,
                Documento: PortariaDocumento,
                DataInicio: PortariaValidadeInicio,
                DataFim: PortariaValidadeFim,
                Tipo: PortariaTipo,
                UnidadeId: PortariaUnidadeId,
                BlocoUnidade: PortariaBlocoUnidade,
                MoradorId: SelectedMoradorId,
                Telefone: PortariaTelefone,
                Empresa: PortariaEmpresa,
                PlacaVeiculo: PortariaPlacaVeiculo,
                Observacoes: PortariaObservacoes);

            var result = await AiClient.ExecutePortariaPluginAsync(req);
            if (result != null && result.IsSuccess && result.Data != null)
            {
                ExecutionResultPortaria = result.Data;
            }
            else
            {
                ErrorMessage = result?.Message ?? "Não foi possível autorizar o visitante na portaria.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Exceção ao invocar a API de portaria: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ExecutarPluginPackageVision()
    {
        IsLoading = true;
        ErrorMessage = null;
        ExecutionResultPackageVision = null;

        try
        {
            var req = new ExecutePackageVisionPluginRequest(
                ImagemEtiqueta: VisionImagemEtiqueta,
                EnviarNotificacao: VisionEnviarNotificacao,
                RecebidoPorNome: VisionRecebidoPor,
                CondoId: 1);

            var result = await AiClient.ExecutePackageVisionPluginAsync(req);
            if (result != null && result.IsSuccess && result.Data != null)
            {
                ExecutionResultPackageVision = result.Data;
            }
            else
            {
                ErrorMessage = result?.Message ?? "Não foi possível executar o plugin de visão/OCR de encomendas.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Exceção ao invocar a API de leitura de etiquetas: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CopiarPix(string codigoPix)
    {
        if (!string.IsNullOrEmpty(codigoPix))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", codigoPix);
        }
    }
}
