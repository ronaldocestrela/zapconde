@page "/ai/playground"
@layout AppShellLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Modules.AIEngine.Application.DTOs
@using SmartCondo.Web.Services
@inject AiApiClient AiApi

<PageTitle>Playground de Prompts - SmartCondo</PageTitle>

<link href="css/ai-engine.css" rel="stylesheet" />

<div class="ai-container">
    <AINavTabs />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 font-weight-bold" style="color: #2E5B88;">
                <span class="material-symbols-outlined align-middle me-2">terminal</span>
                Playground & Testador de Prompts
            </h1>
            <p class="text-muted small mb-0">Envie instruções e prompts para a instância ativa do Semantic Kernel e analise em tempo real o tempo de resposta e consumo de tokens.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="ai-card h-100">
                <h2 class="h6 mb-3 text-primary font-weight-bold d-flex align-items-center gap-2" style="color: #2E5B88 !important;">
                    <span class="material-symbols-outlined">chat</span>
                    Entrada do Prompt
                </h2>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Prompt do Usuário / Morador</label>
                    <textarea @bind="PromptText" class="form-control" rows="6" placeholder="Digite seu prompt aqui... Ex: Quais são as regras para uso do salão de festas no final de semana?"></textarea>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Override Temperatura</label>
                        <input type="number" step="0.1" min="0.0" max="2.0" class="form-control form-control-sm" @bind="TemperatureOverride" placeholder="Padrão" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Override MaxTokens</label>
                        <input type="number" min="50" max="8000" class="form-control form-control-sm" @bind="MaxTokensOverride" placeholder="Padrão" />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PreencherExemplo">
                        Usar Prompt Exemplo
                    </button>
                    <button class="btn text-white fw-bold d-flex align-items-center gap-2" style="background-color: #2E5B88;" @onclick="ExecutarPrompt" disabled="@IsProcessando">
                        @if (IsProcessando)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Executando...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">send</span>
                            <span>Executar Prompt</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="ai-card h-100">
                <h2 class="h6 mb-3 text-primary font-weight-bold d-flex align-items-center gap-2" style="color: #2E5B88 !important;">
                    <span class="material-symbols-outlined">output</span>
                    Resposta do Semantic Kernel
                </h2>

                @if (!string.IsNullOrEmpty(MensagemErro))
                {
                    <div class="alert alert-danger" role="alert">
                        @MensagemErro
                    </div>
                }

                @if (RespostaDto != null)
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="ai-metric-badge ai-badge-provider">
                            <span class="material-symbols-outlined fs-6">memory</span>
                            @RespostaDto.ModelUsed
                        </span>
                        <span class="ai-metric-badge">
                            <span class="material-symbols-outlined fs-6">timer</span>
                            @RespostaDto.DurationMs ms
                        </span>
                        <span class="ai-metric-badge">
                            <span class="material-symbols-outlined fs-6">token</span>
                            Tokens: @RespostaDto.TotalTokens (@RespostaDto.PromptTokens in / @RespostaDto.CompletionTokens out)
                        </span>
                    </div>

                    <div class="ai-playground-response-box">
                        @RespostaDto.Response
                    </div>
                }
                else if (!IsProcessando)
                {
                    <div class="text-center text-muted py-5">
                        <span class="material-symbols-outlined fs-1 text-secondary opacity-50 mb-2">subtitles</span>
                        <p class="mb-0">Insira um prompt ao lado e clique em **Executar Prompt** para visualizar a resposta gerada pelo Semantic Kernel.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string PromptText = "";
    private double? TemperatureOverride;
    private int? MaxTokensOverride;
    private bool IsProcessando = false;
    private string? MensagemErro;
    private ExecutePromptResponseDto? RespostaDto;

    private void PreencherExemplo()
    {
        PromptText = "Qual o procedimento para cadastrar um novo visitante na portaria do condomínio?";
    }

    private async Task ExecutarPrompt()
    {
        if (string.IsNullOrWhiteSpace(PromptText))
        {
            MensagemErro = "Por favor, digite um prompt para ser executado.";
            return;
        }

        IsProcessando = true;
        MensagemErro = null;
        RespostaDto = null;

        var request = new ExecutePromptRequestDto(
            PromptText,
            TemperatureOverride,
            MaxTokensOverride);

        var result = await AiApi.ExecutePromptAsync(request);
        IsProcessando = false;

        if (result?.IsSuccess == true && result.Data != null)
        {
            RespostaDto = result.Data;
        }
        else
        {
            MensagemErro = result?.Message ?? "Erro inesperado ao invocar a engine do Semantic Kernel.";
        }
    }
}
