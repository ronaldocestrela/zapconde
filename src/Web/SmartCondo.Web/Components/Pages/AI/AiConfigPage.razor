@page "/ai/config"
@layout AppShellLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Modules.AIEngine.Application.DTOs
@using Modules.AIEngine.Domain.Enums
@using SmartCondo.Web.Services
@inject AiApiClient AiApi
@inject NavigationManager Navigation

<PageTitle>Configuração do Semantic Kernel - SmartCondo</PageTitle>

<link href="css/ai-engine.css" rel="stylesheet" />

<div class="ai-container">
    <AINavTabs />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 font-weight-bold" style="color: #2E5B88;">
                <span class="material-symbols-outlined align-middle me-2">smart_toy</span>
                Configuração do Microsoft.SemanticKernel
            </h1>
            <p class="text-muted small mb-0">Defina os parâmetros do provedor LLM (OpenAI, Azure OpenAI ou MockLocal) para o atendimento inteligente do condomínio.</p>
        </div>
    </div>

    @if (Summary != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="ai-kpi-card" style="border-left: 4px solid #2E5B88;">
                    <div class="ai-kpi-label">Status do Kernel</div>
                    <div class="ai-kpi-val fs-4">
                        @if (Summary.Configurada)
                        {
                            <span class="text-success fw-bold d-flex align-items-center gap-1 fs-5">
                                <span class="material-symbols-outlined">check_circle</span> Ativo
                            </span>
                        }
                        else
                        {
                            <span class="text-secondary fw-bold d-flex align-items-center gap-1 fs-5">
                                <span class="material-symbols-outlined">pause_circle</span> Inativo
                            </span>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="ai-kpi-card" style="border-left: 4px solid #A3C9A8;">
                    <div class="ai-kpi-label">Provedor Ativo</div>
                    <div class="ai-kpi-val fs-5">@Summary.Provider</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="ai-kpi-card" style="border-left: 4px solid #198754;">
                    <div class="ai-kpi-label">Modelo LLM</div>
                    <div class="ai-kpi-val fs-5">@Summary.ModelId</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="ai-kpi-card" style="border-left: 4px solid #0dcaf0;">
                    <div class="ai-kpi-label">Tokens Totais Consumidos</div>
                    <div class="ai-kpi-val fs-4">@Summary.TotalTokensConsumidos.ToString("N0")</div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(MensagemFeedback))
    {
        <div class="alert @(IsSucessoFeedback ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @MensagemFeedback
            <button type="button" class="btn-close" @onclick="() => MensagemFeedback = null"></button>
        </div>
    }

    <div class="ai-card">
        <h2 class="h5 mb-4 text-primary font-weight-bold d-flex align-items-center gap-2" style="color: #2E5B88 !important;">
            <span class="material-symbols-outlined">tune</span>
            Parâmetros de Conexão e Modelos
        </h2>

        <EditForm Model="FormModel" OnValidSubmit="SalvarConfiguracao">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Provedor de IA</label>
                    <InputSelect @bind-Value="FormModel.Provider" class="form-select">
                        <option value="@AiProvider.MockLocal">MockLocal (Simulador Local Offline)</option>
                        <option value="@AiProvider.OpenAI">OpenAI (Nativo)</option>
                        <option value="@AiProvider.AzureOpenAI">Azure OpenAI Service</option>
                    </InputSelect>
                    <div class="form-text">Utilize MockLocal para testes locais sem consumo de créditos pagados.</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Modelo Chat completion (ModelId)</label>
                    <InputText @bind-Value="FormModel.ModelId" class="form-control" placeholder="ex: gpt-4o-mini" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Modelo Embeddings RAG</label>
                    <InputText @bind-Value="FormModel.EmbeddingModelId" class="form-control" placeholder="ex: text-embedding-3-small" />
                </div>

                @if (FormModel.Provider != AiProvider.MockLocal)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Chave de API (ApiKey)</label>
                        <div class="input-group">
                            <InputText @bind-Value="FormModel.ApiKey" type="@(ExibirChave ? "text" : "password")" class="form-control" placeholder="sk-..." />
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => ExibirChave = !ExibirChave">
                                <span class="material-symbols-outlined">@(ExibirChave ? "visibility_off" : "visibility")</span>
                            </button>
                        </div>
                    </div>
                }

                @if (FormModel.Provider == AiProvider.AzureOpenAI)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Endpoint Azure OpenAI</label>
                        <InputText @bind-Value="FormModel.Endpoint" class="form-control" placeholder="https://seu-recurso.openai.azure.com/" />
                    </div>
                }

                @if (FormModel.Provider == AiProvider.OpenAI)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">ID da Organização (Opcional)</label>
                        <InputText @bind-Value="FormModel.OrgId" class="form-control" placeholder="org-..." />
                    </div>
                }

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Temperatura (0.0 a 2.0)</label>
                    <InputNumber @bind-Value="FormModel.Temperature" class="form-control" step="0.1" min="0.0" max="2.0" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Máximo de Tokens (MaxTokens)</label>
                    <InputNumber @bind-Value="FormModel.MaxTokens" class="form-control" min="100" max="16000" />
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <InputCheckbox @bind-Value="FormModel.IsActive" class="form-check-input" id="checkActive" />
                        <label class="form-check-label fw-semibold" for="checkActive">Kernel Ativo para o Tenant</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <button type="submit" class="btn text-white fw-bold d-flex align-items-center gap-2" style="background-color: #2E5B88;" disabled="@IsSalvando">
                    @if (IsSalvando)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Salvando...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined">save</span>
                        <span>Salvar Configuração</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private AiSummaryDto? Summary;
    private SaveAiConfigModel FormModel = new();
    private bool IsSalvando = false;
    private bool ExibirChave = false;
    private string? MensagemFeedback;
    private bool IsSucessoFeedback;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        var summaryRes = await AiApi.GetSummaryAsync();
        if (summaryRes?.IsSuccess == true)
        {
            Summary = summaryRes.Data;
        }

        var configRes = await AiApi.GetConfigAsync();
        if (configRes?.IsSuccess == true && configRes.Data != null)
        {
            var data = configRes.Data;
            FormModel = new SaveAiConfigModel
            {
                Provider = data.Provider,
                ModelId = data.ModelId,
                EmbeddingModelId = data.EmbeddingModelId,
                ApiKey = "",
                Endpoint = data.Endpoint,
                OrgId = data.OrgId,
                Temperature = data.Temperature,
                MaxTokens = data.MaxTokens,
                IsActive = data.IsActive
            };
        }
    }

    private async Task SalvarConfiguracao()
    {
        IsSalvando = true;
        MensagemFeedback = null;

        var cmd = new SaveAiConfigCommand(
            FormModel.Provider,
            FormModel.ModelId,
            FormModel.EmbeddingModelId,
            FormModel.ApiKey,
            FormModel.Endpoint,
            FormModel.OrgId,
            FormModel.Temperature,
            FormModel.MaxTokens,
            FormModel.IsActive);

        var result = await AiApi.SaveConfigAsync(cmd);
        IsSalvando = false;

        if (result?.IsSuccess == true)
        {
            IsSucessoFeedback = true;
            MensagemFeedback = "Configuração do Semantic Kernel atualizada com sucesso!";
            await CarregarDados();
        }
        else
        {
            IsSucessoFeedback = false;
            MensagemFeedback = result?.Message ?? "Falha ao salvar a configuração de IA.";
        }
    }

    private class SaveAiConfigModel
    {
        public AiProvider Provider { get; set; } = AiProvider.MockLocal;
        public string ModelId { get; set; } = "gpt-4o-mini";
        public string EmbeddingModelId { get; set; } = "text-embedding-3-small";
        public string ApiKey { get; set; } = "";
        public string? Endpoint { get; set; }
        public string? OrgId { get; set; }
        public double Temperature { get; set; } = 0.7;
        public int MaxTokens { get; set; } = 1500;
        public bool IsActive { get; set; } = true;
    }
}
