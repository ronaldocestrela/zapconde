@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthSession Session
@inject NavigationManager Navigation

<PageTitle>ZapCond</PageTitle>

@if (!_sessionReady)
{
    <p style="padding:2rem;font-family:Manrope,sans-serif;">Carregando...</p>
}
else if (Session.Context is null)
{
    <p style="padding:2rem;font-family:Manrope,sans-serif;">Redirecionando para login...</p>
}
else
{
    <section style="padding:2rem;font-family:Manrope,sans-serif;">
        <h1 style="color:#0f436f;">ZapCond</h1>
        <p>Bem-vindo! Perfil ativo: <strong>@Session.Context.Role</strong> (Tenant @Session.Context.TenantId / Condo @Session.Context.CondoId)</p>
        <a href="/acesso-negado">Ver tela de acesso negado</a>
    </section>
}

@code {
    private bool _sessionReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionReady)
        {
            return;
        }

        await Session.EnsureLoadedAsync();

        if (Session.Context is null)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        _sessionReady = true;
        StateHasChanged();
    }
}
